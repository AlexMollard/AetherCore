{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethercore.dev/schemas/agent-report-v1.schema.json",
  "title": "AetherCore agent operation report v1",
  "description": "Queued/running are snapshots with no exit code. Only passed with exitCode 0 is success. Every required check must pass before the aggregate can pass. Required check names must be unique (also validated by the producer).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "status", "phase", "target", "language", "profile", "diagnostics", "toolchains", "artifacts", "requiredChecks", "durationMs", "exitCode"],
  "properties": {
    "schemaVersion": {"const": 1},
    "jobId": {"$ref": "#/$defs/text"},
    "status": {"$ref": "#/$defs/status"},
    "phase": {"$ref": "#/$defs/text"},
    "target": {"$ref": "#/$defs/text"},
    "language": {"$ref": "#/$defs/text"},
    "profile": {"$ref": "#/$defs/text"},
    "durationMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "exitCode": {"type": ["integer", "null"], "enum": [null, 0, 1, 3, 130]},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "toolchains": {"type": "array", "items": {"$ref": "#/$defs/toolchain"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "requiredChecks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/check"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["queued", "running"]}}},
      "then": {"properties": {"exitCode": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "exitCode": {"const": 0},
          "diagnostics": {"not": {"contains": {"properties": {"severity": {"const": "error"}}, "required": ["severity"]}}},
          "requiredChecks": {"items": {"properties": {"status": {"const": "passed"}}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "exitCode": {"const": 1},
          "diagnostics": {"contains": {"properties": {"severity": {"const": "error"}}, "required": ["severity"]}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "cancelled"}}},
      "then": {"properties": {"exitCode": {"const": 130}}}
    },
    {
      "if": {"properties": {"status": {"const": "skipped"}}},
      "then": {"properties": {"exitCode": {"const": 3}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "[^ \t\r\n]"},
    "status": {"enum": ["queued", "running", "passed", "failed", "cancelled", "skipped"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "dependentRequired": {"column": ["line"]},
      "properties": {
        "file": {"$ref": "#/$defs/text"},
        "line": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "column": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/text"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "target"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "hash": {"$ref": "#/$defs/text"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {"name": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/status"}}
    }
  }
}
