{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "lsp": "allow"
  },
  "lsp": {
    "clangd": {
      "command": [
        "C:\\Program Files\\LLVM\\bin\\clangd.exe",
        "--background-index",
        "--compile-commands-dir=.",
        "--clang-tidy",
        "--query-driver=C:/Program Files/LLVM/bin/clang++"
      ],
      "extensions": [".cpp", ".cc", ".cxx", ".c", ".h", ".hpp"]
    }
  }
}