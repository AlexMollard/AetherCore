#ifndef AETHER_LOCAL_SHADOW_SLANGH
#define AETHER_LOCAL_SHADOW_SLANGH

// Local shadow sampling helpers for the shadow atlas (VSM).
// Included by gltf_mesh.slang.
//
// Light type encoding:
//   0 = spot light  (1 consecutive entry in ShadowLightData)
//   1 = point light (6 consecutive cube-style face entries)

static const uint kPointLightShadowFaceCount = 6u;

uint SelectPointShadowFace(float3 lightToReceiver)
{
    float3 a = abs(lightToReceiver);
    if (a.x >= a.y && a.x >= a.z)
    {
        return lightToReceiver.x >= 0.0 ? 0u : 1u;
    }
    if (a.y >= a.z)
    {
        return lightToReceiver.y >= 0.0 ? 2u : 3u;
    }
    return lightToReceiver.z >= 0.0 ? 4u : 5u;
}

struct ShadowLightData
{
    [[vk::offset(0)]]  float4x4 viewProj;
    [[vk::offset(64)]] float4   atlasRegion;   // xy=UV offset, zw=UV scale
    [[vk::offset(80)]] float    depthBias;     // world units
    [[vk::offset(84)]] uint     lightType;     // 0=spot, 1=point
    [[vk::offset(88)]] float    normalBias;    // world units
    [[vk::offset(92)]] float    _pad;
    [[vk::offset(96)]] float4   lightPosRange; // xyz=light world position, w=range
};

// Convert world-space position to shadow atlas UV for a perspective light.
// Returns UV in atlas space (not normalized [0,1] - caller checks region bounds).
float2 LocalShadowUV(float3 worldPos, float4x4 viewProj, float4 atlasRegion)
{
    float4 clipPos = mul(viewProj, float4(worldPos, 1.0));
    float3 ndc = clipPos.xyz / clipPos.w;
    float2 uv = ndc.xy * 0.5 + 0.5;
    return atlasRegion.xy + uv * atlasRegion.zw;
}

float2 LoadVsmMoments(uint atlasSlot, float2 atlasUV, float4 atlasRegion, uint2 atlasSize)
{
    float2 atlasSizeF = float2(atlasSize);
    uint2 regionMin = uint2(floor(atlasRegion.xy * atlasSizeF + 0.5f));
    uint2 regionSize = max(uint2(1u, 1u), uint2(floor(atlasRegion.zw * atlasSizeF + 0.5f)));
    uint2 regionMax = min(atlasSize - uint2(1u, 1u), regionMin + regionSize - uint2(1u, 1u));

    float2 texelPos = atlasUV * atlasSizeF - 0.5f;
    int2 base = int2(floor(texelPos));
    float2 f = frac(texelPos);

    int2 minPx = int2(regionMin);
    int2 maxPx = int2(regionMax);
    uint2 p00 = uint2(clamp(base, minPx, maxPx));
    uint2 p10 = uint2(clamp(base + int2(1, 0), minPx, maxPx));
    uint2 p01 = uint2(clamp(base + int2(0, 1), minPx, maxPx));
    uint2 p11 = uint2(clamp(base + int2(1, 1), minPx, maxPx));

    float2 m00 = g_textures[atlasSlot].Load(int3(p00, 0)).rg;
    float2 m10 = g_textures[atlasSlot].Load(int3(p10, 0)).rg;
    float2 m01 = g_textures[atlasSlot].Load(int3(p01, 0)).rg;
    float2 m11 = g_textures[atlasSlot].Load(int3(p11, 0)).rg;

    return lerp(lerp(m00, m10, f.x), lerp(m01, m11, f.x), f.y);
}

// Evaluate VSM shadow for a single face entry.
float SampleVSM(ShadowLightData sd, float3 worldPos, float3 worldNormal, float3 L, uint atlasSlot, uint2 atlasSize)
{
    float4 clipPos = mul(sd.viewProj, float4(worldPos, 1.0));
    float3 ndc = clipPos.xyz / clipPos.w;

    if (any(ndc.xy < -1.0) || any(ndc.xy > 1.0) || ndc.z < 0.0 || ndc.z > 1.0)
    {
        return 1.0;
    }

    float2 uv = ndc.xy * 0.5 + 0.5;
    float2 atlasUV = sd.atlasRegion.xy + uv * sd.atlasRegion.zw;

    float2 moments = LoadVsmMoments(atlasSlot, atlasUV, sd.atlasRegion, atlasSize);

    // Receiver depth in the same space the caster writes: linear radial
    // distance from the light normalized by range, exponentially warped
    // (local_shadow_depth.slang). Biases are world-space offsets toward the
    // light, applied in linear space before the warp.
    // Must match kEvsmExponent in local_shadow_depth.slang and the atlas
    // clear color exp(c)/exp(2c) in LocalShadowService.cpp.
    const float kEvsmExponent = 40.0;
    const float range = max(sd.lightPosRange.w, 1e-3);
    const float slope = 1.0 - saturate(dot(normalize(worldNormal), normalize(L)));
    // Clamp the world-space bias to a fraction of the light range so small
    // lights (range < ~1m) do not peter-pan by a large slice of their depth.
    const float worldBias = min(sd.depthBias + sd.normalBias * slope, 0.02 * range);
    const float receiverDist = distance(worldPos, sd.lightPosRange.xyz);
    const float receiverDepth = saturate((receiverDist - worldBias) / range);
    const float warpedReceiver = exp(kEvsmExponent * receiverDepth);

    float ex = moments.x;
    float exSq = moments.y;

    // Receiver is in front of all stored occluders - definitely lit.
    if (warpedReceiver <= ex)
    {
        return 1.0;
    }

    // Relative variance floor: exp-warped moments scale with e^(c*d), so an
    // absolute floor would be wrong at both ends of the range.
    float variance = max(exSq - ex * ex, 1e-4 * ex * ex);
    float md = warpedReceiver - ex;
    float p = variance / (variance + md * md);

    // Moderate light-bleed reduction: dark enough to read as a defined shadow
    // (not the washed-out VSM membrane) but not so aggressive that the core goes
    // harsh/black. Between the waxy 0.40 and the harsh 0.60.
    const float kLightBleed = 0.50;
    return saturate((p - kLightBleed) / (1.0 - kLightBleed));
}

// Evaluate shadow visibility for a local light by its ShadowLightData index.
// Returns 1.0 = fully lit, 0.0 = fully shadowed.
float SampleLocalShadow(uint shadowIdx, uint atlasSlot, uint2 atlasSize, float3 worldPos, float3 worldNormal, float3 L, FrameConstantsData* fc)
{
    if (fc->shadowLightDataAddr == 0u || shadowIdx >= fc->shadowLightCount)
    {
        return 1.0;
    }

    ShadowLightData* shadowData = (ShadowLightData*)(fc->shadowLightDataAddr);
    ShadowLightData sd = shadowData[shadowIdx];

    if (sd.lightType == 0u)
    {
        // Spot light: single perspective entry.
        return SampleVSM(sd, worldPos, worldNormal, L, atlasSlot, atlasSize);
    }
    else
    {
        // Point light: pick the cube face that contains this receiver instead
        // of taking the darkest overlapping face, which creates false slivers.
        uint face = SelectPointShadowFace(-normalize(L));
        if (shadowIdx + face >= fc->shadowLightCount)
        {
            return 1.0;
        }
        return SampleVSM(shadowData[shadowIdx + face], worldPos, worldNormal, L, atlasSlot, atlasSize);
    }
}

#endif
