// Local shadow sampling helpers for the shadow atlas (VSM).
// Included by gltf_mesh.slang.
//
// Light type encoding:
//   0 = spot light  (1 consecutive entry in ShadowLightData)
//   1 = point light (2 consecutive entries: front+back faces)

struct ShadowLightData
{
    [[vk::offset(0)]]  float4x4 viewProj;
    [[vk::offset(64)]] float4   atlasRegion;   // xy=UV offset, zw=UV scale
    [[vk::offset(80)]] float    depthBias;
    [[vk::offset(84)]] uint     lightType;     // 0=spot, 1=point
    [[vk::offset(88)]] float2   _pad;
};

// Convert world-space position to shadow atlas UV for a perspective light.
// Returns UV in atlas space (not normalized [0,1] - caller checks region bounds).
float2 LocalShadowUV(float3 worldPos, float4x4 viewProj, float4 atlasRegion)
{
    float4 clipPos = mul(viewProj, float4(worldPos, 1.0));
    float3 ndc = clipPos.xyz / clipPos.w;
    float2 uv = ndc.xy * 0.5 + 0.5;
    return atlasRegion.xy + uv * atlasRegion.zw;
}

// Evaluate VSM shadow for a single face entry.
float SampleVSM(ShadowLightData sd, float3 worldPos, uint atlasSlot, SamplerState samp)
{
    float4 clipPos = mul(sd.viewProj, float4(worldPos, 1.0));
    float3 ndc = clipPos.xyz / clipPos.w;

    if (any(ndc.xy < -1.0) || any(ndc.xy > 1.0) || ndc.z < 0.0 || ndc.z > 1.0)
    {
        return 1.0;
    }

    float2 uv = ndc.xy * 0.5 + 0.5;
    float2 atlasUV = sd.atlasRegion.xy + uv * sd.atlasRegion.zw;

    float2 moments = g_textures[atlasSlot].SampleLevel(samp, atlasUV, 0.0).rg;
    float receiverDepth = ndc.z - sd.depthBias;

    float ex = moments.x;
    float exSq = moments.y;

    // Receiver is in front of all stored occluders - definitely lit.
    if (receiverDepth <= ex)
    {
        return 1.0;
    }

    float variance = max(exSq - ex * ex, 0.0001);
    float md = receiverDepth - ex;
    float p = variance / (variance + md * md);

    const float kLightBleed = 0.65;
    return saturate((p - kLightBleed) / (1.0 - kLightBleed));
}

// Evaluate shadow visibility for a local light by its ShadowLightData index.
// Returns 1.0 = fully lit, 0.0 = fully shadowed.
float SampleLocalShadow(uint shadowIdx, uint atlasSlot, float3 worldPos, SamplerState samp, FrameConstantsData* fc)
{
    ShadowLightData* shadowData = (ShadowLightData*)(fc->shadowLightDataAddr);
    ShadowLightData sd = shadowData[shadowIdx];

    if (sd.lightType == 0u)
    {
        // Spot light: single perspective entry.
        return SampleVSM(sd, worldPos, atlasSlot, samp);
    }
    else
    {
        // Point light: two consecutive entries (front+back).
        float vis0 = SampleVSM(sd, worldPos, atlasSlot, samp);
        ShadowLightData sd1 = shadowData[shadowIdx + 1u];
        float vis1 = SampleVSM(sd1, worldPos, atlasSlot, samp);
        return min(vis0, vis1);
    }
}
