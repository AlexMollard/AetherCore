#ifndef AETHER_BINDLESS_CONTRACT_SLANGH
#define AETHER_BINDLESS_CONTRACT_SLANGH

// Shared bindless descriptor contract for shader-side declarations.
// Keep these values aligned with the descriptor-heap mappings in
// src/engine/vulkan/BindlessManager.cpp (g_textures[] -> set 0 binding 0,
// g_linearSampler -> set 0 binding 1). Sets other than 0 are NOT mapped;
// declaring bindless resources at another set silently reads garbage
// descriptors under VK_EXT_descriptor_heap.

static const uint MEOW_BINDLESS_SET = 0;
static const uint MEOW_BINDLESS_SAMPLED_IMAGE_BINDING = 0;

#define MEOW_BINDLESS_BINDING [[vk::binding(MEOW_BINDLESS_SAMPLED_IMAGE_BINDING, MEOW_BINDLESS_SET)]]

#endif
