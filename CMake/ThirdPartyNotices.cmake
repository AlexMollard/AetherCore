# Generate notices from the exact configured dependency sources. A new dependency
# without a root license must be reviewed rather than silently omitted.
set(_aether_notices "${CMAKE_BINARY_DIR}/data/THIRD_PARTY_NOTICES.txt")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/data")
file(WRITE "${_aether_notices}" "AetherCore third-party notices\n\nOriginal engine distribution remains private; see DISTRIBUTION.md.\nDependency licenses below apply to their respective components.\n\nThis software uses the FreeType Project, https://freetype.org/.\nFreeType is used under the FreeType License (FTL).\n\n")
set(_aether_notice_packages ${CPM_PACKAGES})
list(SORT _aether_notice_packages)
foreach(_package IN LISTS _aether_notice_packages)
    set(_source "${${_package}_SOURCE_DIR}")
    if(NOT IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "Notice inventory: missing source directory for ${_package}")
    endif()
    file(GLOB _licenses LIST_DIRECTORIES FALSE
        "${_source}/LICENSE*" "${_source}/LICENCE*" "${_source}/COPYING*"
        "${_source}/copying*" "${_source}/COPYRIGHT*" "${_source}/NOTICE*")
    if(NOT _licenses)
        message(FATAL_ERROR "Notice inventory: ${_package} has no root license; add reviewed license handling")
    endif()
    if(_package STREQUAL "freetype")
        list(APPEND _licenses "${_source}/docs/FTL.TXT"
            "${_source}/src/bdf/README" "${_source}/src/pcf/README")
    endif()
    list(SORT _licenses)
    foreach(_license IN LISTS _licenses)
        file(READ "${_license}" _text)
        file(RELATIVE_PATH _relative "${_source}" "${_license}")
        file(APPEND "${_aether_notices}" "\n========== ${_package}: ${_relative} ==========\n${_text}\n")
    endforeach()
endforeach()
file(READ "${CMAKE_SOURCE_DIR}/resources/CREDITS.md" _asset_credits)
file(APPEND "${_aether_notices}" "\n========== Engine asset credits ==========\n${_asset_credits}\n")
file(GLOB _asset_licenses LIST_DIRECTORIES FALSE "${CMAKE_SOURCE_DIR}/resources/licenses/*")
foreach(_license IN LISTS _asset_licenses)
    file(READ "${_license}" _text)
    get_filename_component(_name "${_license}" NAME)
    file(APPEND "${_aether_notices}" "\n========== ${_name} ==========\n${_text}\n")
endforeach()
