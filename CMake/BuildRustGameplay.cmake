foreach(required AETHER_GAMEPLAY_MANIFEST AETHER_CARGO_EXECUTABLE AETHER_RUSTC_EXECUTABLE AETHER_RUST_TARGET_DIR AETHER_RUST_OUTPUT_DIR AETHER_RUST_PROFILE AETHER_RUST_MODULE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(lock_args)
if(DEFINED AETHER_LOCK_TIMEOUT)
    list(APPEND lock_args TIMEOUT ${AETHER_LOCK_TIMEOUT})
endif()
file(MAKE_DIRECTORY "${AETHER_RUST_TARGET_DIR}")
# Cargo releases its own lock before staging. Hold this lock over both operations.
file(LOCK "${AETHER_RUST_TARGET_DIR}/aether-build.lock" GUARD PROCESS ${lock_args})
set(profile_args)
if(AETHER_RUST_PROFILE STREQUAL "release")
    list(APPEND profile_args --release)
elseif(NOT AETHER_RUST_PROFILE STREQUAL "debug")
    message(FATAL_ERROR "Rust gameplay profile must be debug or release")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "RUSTC=${AETHER_RUSTC_EXECUTABLE}" "${AETHER_CARGO_EXECUTABLE}"
    build --lib --offline --manifest-path "${AETHER_GAMEPLAY_MANIFEST}" --target-dir "${AETHER_RUST_TARGET_DIR}"
    --message-format=json ${profile_args} RESULT_VARIABLE result OUTPUT_VARIABLE compiler_output)
message("${compiler_output}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cargo compilation failed (${result}); no module staged")
endif()
set(expected "${AETHER_RUST_TARGET_DIR}/${AETHER_RUST_PROFILE}/${AETHER_RUST_MODULE}")
file(REAL_PATH "${expected}" expected)
if(WIN32)
    string(TOLOWER "${expected}" expected)
endif()
set(produced FALSE)
string(REPLACE ";" "\\;" records "${compiler_output}")
string(REPLACE "\n" ";" records "${records}")
foreach(record IN LISTS records)
    string(JSON reason ERROR_VARIABLE error GET "${record}" reason)
    if(NOT error AND reason STREQUAL "compiler-artifact")
        string(JSON count ERROR_VARIABLE error LENGTH "${record}" filenames)
        if(NOT error AND count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON candidate GET "${record}" filenames ${index})
                file(REAL_PATH "${candidate}" candidate)
                if(WIN32)
                    string(TOLOWER "${candidate}" candidate)
                endif()
                if(candidate STREQUAL expected)
                    set(produced TRUE)
                endif()
            endforeach()
        endif()
    endif()
endforeach()
if(NOT produced)
    message(FATAL_ERROR "Cargo did not report the expected gameplay module in this build; no module staged")
endif()
file(MAKE_DIRECTORY "${AETHER_RUST_OUTPUT_DIR}")
file(COPY_FILE "${AETHER_RUST_TARGET_DIR}/${AETHER_RUST_PROFILE}/${AETHER_RUST_MODULE}"
    "${AETHER_RUST_OUTPUT_DIR}/${AETHER_RUST_MODULE}" ONLY_IF_DIFFERENT)
