foreach(required AETHER_GAMEPLAY_PROJECT AETHER_DOTNET_EXECUTABLE AETHER_MANAGED_ARTIFACTS AETHER_MANAGED_OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
set(lock_args)
if(DEFINED AETHER_LOCK_TIMEOUT)
    list(APPEND lock_args TIMEOUT ${AETHER_LOCK_TIMEOUT})
endif()
file(MAKE_DIRECTORY "${AETHER_MANAGED_ARTIFACTS}")
file(LOCK "${AETHER_MANAGED_ARTIFACTS}/aether-build.lock" GUARD PROCESS ${lock_args})
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LIB "${AETHER_DOTNET_EXECUTABLE}"
    build "${AETHER_GAMEPLAY_PROJECT}" --configuration Debug --nologo --verbosity quiet
    --artifacts-path "${AETHER_MANAGED_ARTIFACTS}" -target:Build -getProperty:TargetPath,AssemblyName
    RESULT_VARIABLE result OUTPUT_VARIABLE compiler_output)
message("${compiler_output}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "C# compilation failed (${result}); no assembly staged")
endif()
string(REGEX MATCH "\\{[ \t\r\n]*\"Properties\"[ \t\r\n]*:.*\\}" properties "${compiler_output}")
string(JSON produced ERROR_VARIABLE error GET "${properties}" Properties TargetPath)
if(error)
    message(FATAL_ERROR "MSBuild did not report its current output; no assembly staged")
endif()
file(REAL_PATH "${produced}" produced)
file(REAL_PATH "${AETHER_MANAGED_ARTIFACTS}/bin/AetherGame/debug/AetherGame.dll" expected)
if(WIN32)
    string(TOLOWER "${produced}" produced)
    string(TOLOWER "${expected}" expected)
endif()
if(NOT produced STREQUAL expected)
    message(FATAL_ERROR "MSBuild did not produce the expected gameplay assembly in this build; no assembly staged")
endif()
if(NOT EXISTS "${AETHER_MANAGED_ARTIFACTS}/bin/AetherGame/debug/AetherGame.dll")
    message(FATAL_ERROR "C# build did not produce AetherGame.dll")
endif()
file(MAKE_DIRECTORY "${AETHER_MANAGED_OUTPUT}")
file(COPY "${AETHER_MANAGED_ARTIFACTS}/bin/AetherGame/debug/" DESTINATION "${AETHER_MANAGED_OUTPUT}")
