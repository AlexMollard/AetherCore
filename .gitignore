# Build directories
/build/
/build-*/
/out/
/bin/
/lib/

# .NET artifacts (IDE-side C# builds; ArtifactsPath in Directory.Build.props)
/artifacts/
# Stray per-project intermediates (normally routed to /artifacts via ArtifactsPath)
**/obj/
managed/**/bin/
game/**/bin/

# CMake generated files
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json
/CTestTestfile.cmake
/Testing/
/install_manifest.txt

# Visual Studio / MSBuild
/.vs/
*.sln
# The generated C++ solution is a *.sln and stays ignored. The hand-authored managed
# solution is AetherCore.slnx (XML format) - *.sln doesn't match it, so it is tracked.
*.vcxproj*
*.vcproj*
*.filters
*.user
*.opendb
*.suo
*.ipch
*.pdb
*.obj
*.idb
*.ilk
*.tlog
*.lastbuildstate
*.recipe

# Ninja / Make
.ninja_deps
.ninja_log
build.ninja
Makefile

# Compiler intermediates
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Vulkan / shader outputs
*.spv

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

#node modules
/node_modules/

# Mind memory protocol internal state
/.mind/

# Codebase memory MCP index artifact
/.codebase-memory/

# Knowledge graph (auto-generated, run `graphify update .` to regenerate)
/graphify-out/

# temorary files
/.temp
/audit/
*.tmp
*.log
.aider*
