# Build directories
/build/
/build-*/
/out/
/bin/
/lib/

# .NET artifacts (IDE-side C# builds; ArtifactsPath in Directory.Build.props)
/artifacts/
**/artifacts/
**/Builds/
**/.project/publish.toml
# Stray per-project intermediates (normally routed to /artifacts via ArtifactsPath)
**/obj/
managed/**/bin/
projects/**/bin/
tools/tw-extract/bin/

# CMake generated files
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json
/CTestTestfile.cmake
/Testing/
/install_manifest.txt

# Visual Studio / MSBuild
# Unanchored so it matches .vs/ anywhere (the managed solution lives under managed/).
.vs/
*.sln
# The generated C++ solution is a *.sln and stays ignored. The hand-authored managed
# solution is managed/AetherCore.slnx (XML format) - *.sln doesn't match it, so it is tracked.
*.vcxproj*
*.vcproj*
*.filters
*.user
*.opendb
*.suo
*.ipch
*.pdb
*.obj
*.idb
*.ilk
*.tlog
*.lastbuildstate
*.recipe

# Ninja / Make
.ninja_deps
.ninja_log
build.ninja
Makefile

# Compiler intermediates
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Vulkan / shader outputs
*.spv

# Baked model artifacts. Cooked from source glTF/GLB by the editor's bake-on-drop
# (EnsureModelBaked / MeshProcessor) or, project-wide, by `AssetPacker bake-all
# <project-root>` (walks assets/models, re-bakes anything missing or staler than its
# source - see tools/assetpack/main.cpp). They are derived data: regenerated on demand
# and packed into project.pak on Publish, and version-fragile (rejected once the baker
# format bumps, e.g. MESH_VERSION), so they must not be committed. Commit the source
# (.gltf/.bin/textures) instead. `bake-all` is what makes ignoring them here safe rather
# than accidental: a fresh clone genuinely has zero baked meshes until someone (or a build
# step) runs it, so relying on "the Editor will bake it on demand" alone silently drops
# any model that's never scene-authored (e.g. a catalogue array in a C# script).
# Force one in with `git add -f` if a project ever needs an authored .mesh/.material.
*.mesh
*.skel
*.animset
*.anim
*.material

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

#node modules
/node_modules/

# Mind memory protocol internal state
/.mind/

# OpenCode plugins and local tool state
/.opencode/

# Codebase memory MCP index artifact
/.codebase-memory/

# Knowledge graph (auto-generated, run `graphify update .` to regenerate)
/graphify-out/

# temorary files
/.temp
/audit/
/logs/
*.tmp
*.log
.aider*
gauntlet-report.json

# Python bytecode cache (MCP server / tooling)
__pycache__/
*.pyc

# Generated per-project launcher preview thumbnails (editor writes these on save)
**/.aether/preview.png

# Autosave recovery copies. Machine-local and transient by definition - they exist only
# between a crash and the next time the editor offers them back. Committing one would put
# a half-finished scene from someone else's session into the history, and it would shadow
# nothing useful, since the real scene is already tracked beside it.
**/.aether/recovery/

# Editor-generated per-project VS solution (paths are machine-local)
AetherGame.slnx

# Twinsanity workbench (docs/twinsanity-editor.md): ISO-derived study content never
# enters this public repo. Extracted models/textures/audio land in the project's
# assets/, and PS2 captures/scans land in reference/ - both machine-local.
# Hand-written shader sources are ours, not ISO-derived, and stay tracked.
projects/Twinsanity/assets/*
!projects/Twinsanity/assets/shaders/
projects/Twinsanity/assets/shaders/*
!projects/Twinsanity/assets/shaders/*.slang
projects/Twinsanity/reference/

# Cooked scene/prefab binaries (derived from the .toml source)
*.scene.bin
*.prefab.bin

# ImGui window layout state - written next to whatever the working directory is
# when the editor runs, so it turns up at the repo root and under projects/
imgui.ini

# Release packaging output (cmake --install staging, installer + zip).
/staging/
/dist/

# CPM_SOURCE_CACHE, when pointed at the tree the way CI does.
.cpm-cache/
