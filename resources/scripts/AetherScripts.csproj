<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AetherScripts is the game-logic assembly. The engine loads it into a
    collectible AssemblyLoadContext that can be swapped at runtime (hot reload).

    The AetherCore.Managed reference is compile-only (Private=false): the engine
    already loaded AetherCore.Managed into the default context, and the scripts'
    ALC resolves it from there. Shipping a second copy would give EntityScript a
    different type identity and break instance creation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AetherScripts</AssemblyName>
    <RootNamespace>AetherScripts</RootNamespace>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../managed/AetherCore.Managed/AetherCore.Managed.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
