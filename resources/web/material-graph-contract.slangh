#ifndef AETHER_WEB_MATERIAL_GRAPH_CONTRACT
#define AETHER_WEB_MATERIAL_GRAPH_CONTRACT
// Portable material surface ABI 1. The five material textures retain native slot order.
struct GraphInput
{
    float2 uv;
    float3 worldPos, worldNormal, worldTangent, vertexColor;
    float tangentSign;
    uint textureMask;
};
struct GraphSurface
{
    float3 baseColor;
    float metallic, roughness;
    float3 emissive, normal;
};
bool GraphTexturePresent(uint mask, uint slot) { return (mask & (1u << slot)) != 0; }
float4 GraphSampleTextureGrad(uint slot, float2 uv, float2 dx, float2 dy)
{
    dx *= exp2(frame.time.z);
    dy *= exp2(frame.time.z);
    switch (slot)
    {
        case 0u: return albedo.SampleGrad(materialSampler, uv, dx, dy);
        case 1u: return normalMap.SampleGrad(materialSampler, uv, dx, dy);
        case 2u: return metallicRoughness.SampleGrad(materialSampler, uv, dx, dy);
        case 3u: return occlusion.SampleGrad(materialSampler, uv, dx, dy);
        case 4u: return emissive.SampleGrad(materialSampler, uv, dx, dy);
        default: return float4(1);
    }
}
float4 GraphSampleTexture(uint slot, float2 uv)
{
    // Generated nodes invoke this outside per-fragment branches. Hand-written
    // adapters branching on surface data use GraphSampleTextureGrad instead,
    // capturing gradients before the branch.
    const float2 dx = ddx(uv), dy = ddy(uv);
    return GraphSampleTextureGrad(slot, uv, dx, dy);
}
#endif
