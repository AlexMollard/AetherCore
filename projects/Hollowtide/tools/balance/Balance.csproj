<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The balance harness. Compiles the game's RULES - and only the rules - into a console
    app and plays them at speed.

    This is possible because Vigil, Content and Numbers carry no AetherCore reference by
    design, and it is the payoff for having kept them that way: the economy can be played
    ten thousand times without a window, a canvas or a frame. Every number in this game was
    set by running it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../scripts/Vigil.cs" />
    <Compile Include="../../scripts/Content.cs" />
    <Compile Include="../../scripts/Relics.cs" />
    <Compile Include="../../scripts/VigilSaveData.cs" />
    <Compile Include="../../scripts/Numbers.cs" />
    <Compile Include="../../scripts/Palette.cs" />
    <Compile Include="../../scripts/Typography.cs" />
    <Compile Include="../../scripts/Layout.cs" />
    <Compile Include="Balance.cs" />
  </ItemGroup>

</Project>
