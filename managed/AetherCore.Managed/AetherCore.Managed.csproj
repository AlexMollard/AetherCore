<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AetherCore.Managed is the engine-facing C# API assembly. It is NOT hot-reloaded:
    its types define the native<->managed ABI, so the host loads it once into the
    default load context. Game scripts (AetherScripts.dll) reference this assembly
    and live in a separate collectible context that can be swapped at runtime.

    GenerateRuntimeConfigurationFiles emits AetherCore.Managed.runtimeconfig.json,
    which hostfxr_initialize_for_runtime_config reads to pick the shared runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AetherCore.Managed</AssemblyName>
    <RootNamespace>AetherCore.Managed</RootNamespace>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- GC tuned for a game host: workstation concurrent, keep decommitted VM
         around to avoid re-faulting pages between frames. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

</Project>
