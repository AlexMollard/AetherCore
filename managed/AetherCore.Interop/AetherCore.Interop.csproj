<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AetherCore.Interop is the ABI/host-boot assembly the native DotNetHost binds:
    it owns the [UnmanagedCallersOnly] Bootstrap.Init entry point, the collectible
    ScriptRegistry load context, and the blittable ABI structs (Abi.cs). It is
    hidden from game code (the game references only the AetherCore SDK).

    Because the host initializes the runtime from THIS assembly's runtimeconfig,
    GenerateRuntimeConfigurationFiles and the process-wide GC policy live here.
  -->
  <PropertyGroup>
    <AssemblyName>AetherCore.Interop</AssemblyName>
    <RootNamespace>AetherCore.Interop</RootNamespace>

    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!--
      Copy NuGet dependencies into the output. A library does not do this by default: it
      leaves them to be resolved from the machine's package cache through deps.json, which
      works on the machine that built it and nowhere else. The compiler assemblies have to
      SHIP, so they have to be in the output directory CMake stages.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Roslyn ships translated diagnostics for thirteen languages. The engine logs in
         English, so they are weight in every download for text nothing will read. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- GC tuned for a game host: workstation concurrent, keep decommitted VM
         around to avoid re-faulting pages between frames. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherCore/AetherCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The C# compiler, hosted in-process. The editor compiles a project's scripts itself
      rather than shelling out to `dotnet build`, so that a machine with no .NET SDK - which
      is most machines - can still open a project and press Play. See ScriptCompiler.cs.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
