#ifndef AETHER_RENDER_CONTRACTS_SLANGH
#define AETHER_RENDER_CONTRACTS_SLANGH

#include "DevicePointer.slangh"

// Shared CPU -> GPU render contracts.
// Keep in sync with src/engine/rendering/GpuContracts.hpp.
//
// Address fields are declared as DevicePtr<T> on the shader side. The host
// (C++) writes plain gpu::DeviceAddress (uint64_t) values at the same offsets;
// DevicePtr<T> is layout-identical to uint64_t, so the binary contract is
// unchanged. The static_asserts in GpuContracts.hpp guard the host layout.

struct DrawInstanceData
{
    [[vk::offset(0)]]  float4x4 model;
    [[vk::offset(64)]] uint     materialIndex;
    [[vk::offset(68)]] uint     skinPaletteOffset;
    [[vk::offset(72)]] uint     skinJointCount;
    [[vk::offset(76)]] uint     effectParamIndex; // per-entity EffectParams slot; 0xFFFFFFFF = no effect
    [[vk::offset(80)]] float4   worldBoundingSphere;
    [[vk::offset(96)]] uint64_t vertexBufferAddr; // BDA of the vertex data for this draw
};

struct DrawPushConstants
{
    [[vk::offset(0)]]  DevicePtr<FrameConstantsData> frame;
    [[vk::offset(8)]]  DevicePtr<DrawInstanceData>   instanceData;
    [[vk::offset(16)]] DevicePtr<float4x4>           skinPalette; // float4x4 joints; 0 means unskinned
    [[vk::offset(24)]] DevicePtr<float4>             lightData;
    [[vk::offset(32)]] DevicePtr<uint2>              tileHeaders;
    [[vk::offset(40)]] DevicePtr<uint>               tileLightIndices;
};

struct CullDrawInput
{
    [[vk::offset(0)]] uint indexCount;
    [[vk::offset(4)]] uint instanceCount;
    [[vk::offset(8)]] uint firstIndex;
    [[vk::offset(12)]] int vertexOffset;
    [[vk::offset(16)]] uint firstInstance;
    [[vk::offset(20)]] uint batchIndex;
    [[vk::offset(24)]] uint _pad0;
    [[vk::offset(28)]] uint _pad1;
};

struct CullBatch
{
    [[vk::offset(0)]] uint inputStart;
    [[vk::offset(4)]] uint drawCount;
    [[vk::offset(8)]] uint outputStart;
    [[vk::offset(12)]] uint _pad;
};

struct CullPushConstants
{
    [[vk::offset(0)]]  DevicePtr<FrameConstantsData> frame;
    [[vk::offset(8)]]  DevicePtr<DrawInstanceData>   instanceData;
    [[vk::offset(16)]] DevicePtr<CullDrawInput>      inputCmd;
    [[vk::offset(24)]] DevicePtr<uint>               outputCmd;   // VkDrawIndexedIndirectCommand stream (5 uint32 per draw)
    [[vk::offset(32)]] DevicePtr<CullBatch>          batchDesc;
    [[vk::offset(40)]] uint64_t                      batchCountAddr; // unused, reserved
    [[vk::offset(48)]] uint                          totalDrawCount;
    [[vk::offset(52)]] uint                          debugFlags;
    [[vk::offset(56)]] uint                          _pad0;
    [[vk::offset(60)]] uint                          _pad1;
};

static const uint kCullMultiFrustumCount = 3u;

struct CullMultiPushConstants
{
    [[vk::offset(0)]]  DevicePtr<FrameConstantsData> frame[kCullMultiFrustumCount];
    [[vk::offset(24)]] DevicePtr<DrawInstanceData>   instanceData;
    [[vk::offset(32)]] DevicePtr<CullDrawInput>      inputCmd;
    [[vk::offset(40)]] DevicePtr<uint>               outputCmd;
    [[vk::offset(48)]] DevicePtr<CullBatch>          batchDesc;
    [[vk::offset(56)]] uint                          totalDrawCount;
    [[vk::offset(60)]] uint                          outputCascadeStride; // bytes per cascade region
    [[vk::offset(64)]] uint                          debugFlags;
    [[vk::offset(68)]] uint                          _pad0;
};

static const uint kCullDebugForceVisibleBit = 1u;

#endif
