#ifndef AETHER_WATER_SLANGH
#define AETHER_WATER_SLANGH

// Twinsanity water look (kFlagWater): the sea, shoreline, rivers, pools and waterfalls.
//
// The PS2 drew its water as scrolling additive/blended sheets over a seabed a few tens of
// centimetres down. This keeps those sheets, their textures and their rig-matched UV scroll, and
// shades them as water on top:
//   * depth tint - the water between the surface and the seabed behind it (the opaque depth
//     buffer) goes from turquoise in the shallows to deep blue, and gets more opaque with depth;
//   * reflections - its own screen-space march over the opaque depth, reading the prepass base
//     colour (the engine's SSR pass only sees gbuffer surfaces, and blended water is not one),
//     falling back to a sky tint where the ray leaves the screen or reaches the sky dome;
//   * a gentle procedural ripple normal (a few crossing waves, domain-warped so it never reads
//     as a grid) that drives the fresnel, the reflection and sharp sun glints;
//   * soft animated foam: the PS2 texture's own foam (so the shore foam keeps its orientation),
//     softened and dissolving, plus contact foam wherever the water meets the ground;
//   * waterfalls (steep surfaces): a second, same-speed flow layer and bright streaks instead of
//     the depth tint.
// The PS2 texel stays in the body as brightness, so the sea keeps its original pattern.
//
// Per-material knobs (Material component fields, repurposed for water):
//   roughness  reflection switch: <= kWaterSsrMaxRoughness marches a screen-space reflection, above
//              mirrors the sky only (stacked ocean layers set 1 so only the top sheet pays for it)
//   metallic   depth bias in metres added to the measured depth (open-ocean sheets that sit a few
//              cm over another sheet set ~3 so they read deep, not shallow)
//   emissive   sky reflection colour (the Twinsanity sky is a textured dome that is not in the
//              depth/base-colour buffers); 0 falls back to the scene's sky gradient
// Every constant below is a look choice, not measured - logs/look/WaterLook/README.md.

static const float3 kWaterShallow = float3(0.06, 0.62, 0.55); // linear turquoise over sand
static const float3 kWaterDeep = float3(0.0, 0.085, 0.38);    // linear vivid deep blue (the PS2 sea's hue)
static const float kWaterDepthScale = 0.2;    // m: deepness = 1 - exp(-depth / scale)
static const float kWaterShallowAlpha = 0.30; // coverage over the shallowest sand
static const float kWaterDeepAlpha = 0.92;    // coverage once deep
static const float kWaterEdgeSoft = 0.06;     // m: coverage fades in over this depth at the waterline
static const float kWaterPattern = 0.3;       // how strongly the PS2 texel pattern modulates the body (higher tiles into a checker seen from above)
static const float kWaterRippleAmp = 1.0;     // ripple slope scale
static const float kWaterGlint = 1.0;         // sun glint strength
static const float kWaterGlintCap = 24.0;     // brightest glint, so one texel cannot blow out
static const float kWaterFoamContact = 0.25;  // m: contact foam band where water meets ground
static const float kWaterFoam = 1.0;          // foam brightness
static const float kWaterGlintRoughness = 0.06; // sun glint lobe (independent of the material's SSR knob)
static const float kWaterSsrMaxRoughness = 0.5;
static const uint kWaterSsrSteps = 20u;
static const float kWaterFresnelCap = 0.6;   // most of the view the reflection may take (grazing)
static const float kWaterSkyTint = 0.45;     // how far the mirrored sky leans to the water colour
static const float kWaterSsrLength = 60.0;    // m

// Ripple height gradient (d/dx, d/dz) at world xz: five crossing travelling waves with a slow
// domain warp so the crests wander instead of forming a lattice. `flow` stretches the pattern
// along a direction (waterfalls). Returned already faded by the pixel footprint.
float2 WaterRippleGradient(float2 p, float t, float footprint)
{
	// Warp: moves the sample point a little, slowly, so wave crests bend and drift.
	p += 0.35 * float2(sin(p.y * 0.37 + t * 0.31), sin(p.x * 0.29 - t * 0.27));
	// (direction.xy, spatial frequency, angular speed), amplitude falls with frequency.
	const float4 waves[5] = {
		float4(0.866, 0.500, 0.9, 0.9),
		float4(-0.423, 0.906, 1.6, 1.3),
		float4(0.259, -0.966, 2.7, 1.9),
		float4(-0.940, -0.342, 4.3, 2.6),
		float4(0.643, 0.766, 6.9, 3.4),
	};
	float2 g = float2(0.0, 0.0);
	[unroll]
	for (uint i = 0u; i < 5u; ++i)
	{
		const float4 w = waves[i];
		const float amp = 0.045 / w.z;
		// A wave shorter than a few pixels only aliases: fade it before it does.
		const float fade = 1.0 - smoothstep(0.25, 0.9, footprint * w.z);
		g += w.xy * (amp * w.z * cos(dot(w.xy, p) * w.z + t * w.w) * fade);
	}
	return g * kWaterRippleAmp;
}

// Scalar ripple height for foam dissolve (same waves, cheap subset), roughly -1..1.
float WaterRippleHeight(float2 p, float t)
{
	return 0.5 * sin(dot(float2(0.866, 0.5), p) * 1.9 + t * 1.1)
		+ 0.3 * sin(dot(float2(-0.423, 0.906), p) * 3.3 - t * 1.7)
		+ 0.2 * sin(dot(float2(0.259, -0.966), p) * 5.1 + t * 2.3);
}

// Opaque-scene world position behind this pixel (seabed / bank / cliff), from the depth buffer.
bool WaterSceneBehind(FrameConstantsData* fc, float2 svPos, out float3 behind, out float sceneZ)
{
	behind = float3(0.0, 0.0, 0.0);
	sceneZ = 1.0;
	const ResourceEntry depthEntry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_SceneDepth);
	if (depthEntry.type != kResourceTypeBindlessTexture || depthEntry.address == 0xFFFFFFFFu || depthEntry.width == 0u || depthEntry.height == 0u)
	{
		return false;
	}
	const int2 texel = clamp(int2(svPos), int2(0, 0), int2(depthEntry.width - 1u, depthEntry.height - 1u));
	sceneZ = g_textures[uint(depthEntry.address)].Load(int3(texel, 0)).r;
	if (sceneZ >= 1.0)
	{
		return false; // sky behind: bottomless
	}
	const float2 ndc = (float2(texel) + 0.5) / float2(depthEntry.width, depthEntry.height) * 2.0 - 1.0;
	float4 w = mul(fc->invViewProj, float4(ndc, sceneZ, 1.0));
	behind = w.xyz / max(w.w, 1e-6);
	return true;
}

// View depth (distance along the camera axis) for a device depth, as ssr.slang measures it.
float WaterLinearDepth(FrameConstantsData* fc, float ndcZ)
{
	const float4 v = mul(fc->invViewProj, float4(0.0, 0.0, ndcZ, 1.0));
	return length(v.xyz / max(v.w, 1e-6) - fc->cameraWorldPos.xyz);
}

// Screen-space reflection for the water surface: marches the reflected ray in clip space (so the
// per-step perspective divide keeps it exact) against the opaque depth buffer, then reads the
// prepass base colour at the hit. rgb = reflected colour, a = confidence (0 = use the sky).
float4 WaterScreenReflection(FrameConstantsData* fc, float3 origin, float3 R, float2 svPos)
{
	const ResourceEntry depthEntry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_SceneDepth);
	const ResourceEntry colorEntry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_SceneBaseColor);
	if (depthEntry.type != kResourceTypeBindlessTexture || colorEntry.type != kResourceTypeBindlessTexture
		|| depthEntry.address == 0xFFFFFFFFu || colorEntry.address == 0xFFFFFFFFu || depthEntry.width == 0u || depthEntry.height == 0u)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	const uint depthSlot = uint(depthEntry.address);
	const float2 extent = float2(depthEntry.width, depthEntry.height);

	const float4 startClip = mul(fc->viewProj, float4(origin, 1.0));
	float4 endClip = mul(fc->viewProj, float4(origin + R * kWaterSsrLength, 1.0));
	if (startClip.w <= 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	// A ray heading behind the camera: stop it just in front of the near plane.
	if (endClip.w < 0.05)
	{
		const float s = (startClip.w - 0.05) / max(startClip.w - endClip.w, 1e-4);
		endClip = lerp(startClip, endClip, s);
	}

	const float jitter = InterleavedGradientNoise(svPos);
	float prevT = 0.0;
	float hitT = -1.0;
	[loop]
	for (uint i = 1u; i <= kWaterSsrSteps; ++i)
	{
		// Quadratic spacing: fine steps near the surface where contact reflections live.
		const float u = (float(i) - 1.0 + jitter) / float(kWaterSsrSteps);
		const float t = u * u;
		const float4 clip = lerp(startClip, endClip, t);
		const float3 ndc = clip.xyz / clip.w;
		const float2 uv = ndc.xy * 0.5 + 0.5;
		if (any(uv < 0.0) || any(uv > 1.0))
		{
			break;
		}
		const float sceneZ = g_textures[depthSlot].Load(int3(int2(uv * extent), 0)).r;
		if (ndc.z > sceneZ && sceneZ < 1.0)
		{
			const float sceneLin = WaterLinearDepth(fc, sceneZ);
			// Thicker in the distance, where one depth texel spans more world, and never thinner
			// than this step: a grazing ray crossing a surface in one long step is still a hit
			// (otherwise the jitter alternates hit/miss per pixel into a checkerboard).
			if (clip.w - sceneLin < 0.4 + 0.03 * clip.w + kWaterSsrLength * (t - prevT))
			{
				float lo = prevT;
				float hi = t;
				[unroll]
				for (uint r = 0u; r < 4u; ++r)
				{
					const float mid = 0.5 * (lo + hi);
					const float4 mc = lerp(startClip, endClip, mid);
					const float3 mn = mc.xyz / mc.w;
					const float mz = g_textures[depthSlot].Load(int3(int2((mn.xy * 0.5 + 0.5) * extent), 0)).r;
					if (mn.z > mz)
					{
						hi = mid;
					}
					else
					{
						lo = mid;
					}
				}
				hitT = hi;
				break;
			}
		}
		prevT = t;
	}
	if (hitT < 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	const float4 hc = lerp(startClip, endClip, hitT);
	const float2 hitUv = saturate((hc.xy / hc.w) * 0.5 + 0.5);
	const float2 edge = min(hitUv, 1.0 - hitUv);
	const float confidence = saturate(min(edge.x, edge.y) / 0.06) * (1.0 - smoothstep(0.6, 1.0, hitT));
	const float3 color = g_textures[uint(colorEntry.address)].SampleLevel(g_linearSampler, hitUv, 0.0).rgb;
	return float4(color, confidence);
}

// Shades one water fragment. albedo/alpha: the PS2 texel x material x vertex colour (the sea's
// original look); uv: the scrolled UV the PS2 texture was sampled with; bakedLight: vertex colour
// x material factor (the bake's lighting); sunVisibility: shadow maps + clouds. Returns the colour
// and writes the blend coverage.
float3 WaterShade(FrameConstantsData* fc, GpuMaterial mat, float3 albedo, float alpha, float2 uv, float2 meshUv,
	float3 worldPos, float3 Ngeom, float2 svPos, float3 bakedLight, float sunVisibility, out float coverage)
{
	const float t = fc->elapsedTime;
	const float3 toEye = fc->cameraWorldPos.xyz - worldPos;
	const float eyeDist = length(toEye);
	const float3 V = toEye / max(eyeDist, 1e-4);
	const float3 Nup = dot(Ngeom, V) < 0.0 ? -Ngeom : Ngeom; // double-sided sheets seen from below
	const bool blended = (mat.flags & kFlagAlphaBlend) != 0u;
	// 1 on a waterfall face, 0 on a flat sheet.
	const float steep = 1.0 - smoothstep(0.35, 0.75, abs(Nup.y));
	const float3 kLuma = float3(0.2126, 0.7152, 0.0722);

	// ── Ripple normal ─────────────────────────────────────────────────────
	const float footprint = length(fwidth(worldPos));
	float3 N;
	{
		// Flat water ripples in world xz. A waterfall's ripple lies in its own plane, stretched
		// down the fall so it reads as flow rather than chop.
		const float3 T = normalize(abs(Nup.y) < 0.99 ? cross(float3(0.0, 1.0, 0.0), Nup) : float3(1.0, 0.0, 0.0));
		const float3 B = cross(Nup, T);
		const float2 flat = worldPos.xz;
		const float2 fall = float2(dot(worldPos, T) * 1.6, dot(worldPos, B) * 0.35);
		const float2 p = lerp(flat, fall, steep);
		const float2 g = WaterRippleGradient(p, t, footprint * lerp(1.0, 1.6, steep));
		const float3 gw = lerp(float3(g.x, 0.0, g.y), T * g.x + B * g.y, steep);
		N = normalize(Nup - gw);
	}
	const float NdotV = saturate(dot(N, V));

	// ── Depth ─────────────────────────────────────────────────────────────
	float3 behind;
	float sceneZ;
	const bool haveBehind = blended && WaterSceneBehind(fc, svPos, behind, sceneZ);
	// Vertical depth for a flat sheet (the seabed straight under it), distance through the
	// water along the view for anything steep.
	float depth = 50.0; // nothing opaque behind (sky, or an opaque sheet): bottomless
	if (haveBehind)
	{
		depth = max(lerp(worldPos.y - behind.y, distance(worldPos, behind), steep), 0.0);
	}
	const float waterDepth = depth + max(mat.metallicFactor, 0.0);
	const float deepness = lerp(1.0 - exp(-waterDepth / kWaterDepthScale), 0.35, steep);

	// ── Light ─────────────────────────────────────────────────────────────
	// The bake's brightness (its hue is the PS2's blue, which the tint replaces), pulled down by
	// real-time shadows the way the baked path shades scenery.
	const float bakeLum = clamp(dot(bakedLight, kLuma), 0.25, 1.6);
	const float shade = lerp(1.0, 0.45 + 0.55 * sunVisibility, fc->shadowParams.z);
	const float3 light = bakeLum * shade;

	// ── Body ──────────────────────────────────────────────────────────────
	// The PS2 texel's brightness against its own average keeps the original caustic pattern.
	float3 avgTex = albedo;
	if (mat.albedoSlot != kNoTexture)
	{
		avgTex = mat.baseColorFactor.rgb * g_textures[mat.albedoSlot].SampleLevel(g_linearSampler, uv, 12.0).rgb;
	}
	const float pattern = clamp(dot(albedo, kLuma) / max(dot(avgTex, kLuma), 1e-4), 0.0, 2.5);
	const float3 tint = lerp(kWaterShallow, kWaterDeep, deepness);
	float3 body = tint * light * lerp(1.0, pattern, kWaterPattern);
	// Shallow caustic sparkle: the pattern's bright cells light the sand through the water.
	body += kWaterShallow * light * (saturate(pattern - 1.0) * (1.0 - deepness) * 0.6 * sunVisibility);

	// Waterfall: keep the PS2 fall texture (it is the identity), add a second flow layer at the
	// same world speed (half the tiling, half the UV rate) and white streaks where both are bright.
	if (steep > 0.001 && mat.albedoSlot != kNoTexture)
	{
		const float2 uv2 = meshUv * float2(0.5, 0.5) + fract(mat.uvScroll * 0.5 * t) + float2(0.37, 0.0);
		const float3 layer2 = mat.baseColorFactor.rgb * g_textures[mat.albedoSlot].Sample(g_linearSampler, uv2).rgb;
		const float streak = smoothstep(0.9, 1.6, pattern) * smoothstep(0.9, 1.5, dot(layer2, kLuma) / max(dot(avgTex, kLuma), 1e-4));
		const float3 fall = lerp(albedo, layer2, 0.4) * lerp(1.0, 1.15, sunVisibility) + streak * 0.45 * light;
		body = lerp(body, fall, steep);
	}

	// ── Foam ──────────────────────────────────────────────────────────────
	// The PS2's own foam is its grey texels (the sea is blue): the sheet's UV layout puts it along
	// the shore, so reading it from the same UV keeps its orientation. A blurrier mip softens its
	// hard painted edges; a slowly moving ripple height dissolves its edge so it breathes.
	float foam = 0.0;
	if (mat.albedoSlot != kNoTexture)
	{
		const float4 soft = g_textures[mat.albedoSlot].SampleBias(g_linearSampler, uv, 1.5);
		const float grey = saturate((soft.r / max(soft.b, 1e-3) - 0.35) * 2.5) * soft.a;
		const float h = WaterRippleHeight(worldPos.xz * 1.3, t);
		foam = smoothstep(0.35 + 0.2 * h, 0.75 + 0.2 * h, grey);
	}
	// Contact foam where the water meets the ground, broken up and lapping with the ripple.
	if (haveBehind && steep < 0.5)
	{
		const float h = WaterRippleHeight(worldPos.xz * 2.1 + 7.0, t * 1.3);
		const float band = kWaterFoamContact * (0.75 + 0.25 * sin(t * 1.4 + (worldPos.x + worldPos.z) * 0.45));
		const float contact = 1.0 - smoothstep(0.0, band, depth);
		foam = max(foam, contact * smoothstep(-0.3, 0.5, h + contact * 0.6));
	}
	foam *= 1.0 - steep; // a fall's texture is grey-blue all over: its streaks come from the flow layer
	body = lerp(body, float3(1.0, 1.0, 1.0) * (kWaterFoam * light), foam);

	// ── Reflection ────────────────────────────────────────────────────────
	const float3 R = reflect(-V, N);
	const float3 Rup = float3(R.x, abs(R.y), R.z); // a ripple can tip R under the horizon
	float3 skyRefl;
	if (dot(mat.emissiveFactor.rgb, mat.emissiveFactor.rgb) > 1e-6)
	{
		// Authored sky colour: brighter at the horizon, a little deeper overhead.
		skyRefl = mat.emissiveFactor.rgb * lerp(1.1, 0.75, saturate(Rup.y));
	}
	else
	{
		skyRefl = SkyGradient(Rup, normalize(fc->sunDirectionIntensity.xyz), fc->sunColor.rgb, fc->sunDirectionIntensity.w,
			fc->skyHorizonColor.rgb, fc->skyZenithColor.rgb, fc->skyVoidColor.rgb, fc->skyParams, fc->shadingParams.y, 0.2);
	}
	// Cartoon water: the sky it mirrors leans towards the water's own colour.
	skyRefl = lerp(skyRefl, tint * light * 2.0, kWaterSkyTint);
	float3 refl = skyRefl;
	// Looking down at the water the reflected ray heads back up past the camera: the screen holds
	// nothing for it and the jittered march alternates hit/miss per pixel (a checkerboard), while the
	// fresnel there is ~2% anyway. So the march fades out as the view steepens and stops altogether.
	const float ssrView = 1.0 - smoothstep(0.5, 0.8, saturate(dot(Nup, V)));
	if (mat.roughnessFactor <= kWaterSsrMaxRoughness && ssrView > 0.0)
	{
		const float3 origin = worldPos + Nup * (0.02 + eyeDist * 0.002);
		const float4 ssr = WaterScreenReflection(fc, origin, R, svPos);
		refl = lerp(skyRefl, ssr.rgb * shade, ssr.a * ssrView);
	}
	// Schlick fresnel for water (F0 0.02), capped below 1 so the far sea keeps some body colour.
	const float F = min(0.02 + 0.98 * pow(1.0 - NdotV, 5.0), kWaterFresnelCap) * (1.0 - foam);

	// ── Sun glints ────────────────────────────────────────────────────────
	const float3 L = normalize(fc->sunDirectionIntensity.xyz);
	const float3 H = normalize(V + L);
	const float glintRough = max(kWaterGlintRoughness, sqrt(footprint * 0.02));
	const float NdotL = saturate(dot(N, L));
	const float spec = min(D_GGX(saturate(dot(N, H)), glintRough) * 0.25 * NdotL, kWaterGlintCap);
	const float3 glint = fc->sunColor.rgb * fc->sunDirectionIntensity.w * spec * (0.02 + 0.98 * pow(1.0 - saturate(dot(V, H)), 5.0))
		* (kWaterGlint * sunVisibility * (1.0 - foam));

	// ── Compose ───────────────────────────────────────────────────────────
	if (!blended)
	{
		coverage = 1.0;
		return body * (1.0 - F) + refl * F + glint;
	}
	float a = lerp(kWaterShallowAlpha, kWaterDeepAlpha, deepness);
	a = lerp(a, saturate(alpha * 1.2), steep);
	if (haveBehind)
	{
		a *= smoothstep(0.0, kWaterEdgeSoft, depth); // no hard waterline against the ground
	}
	a = max(a, foam * 0.95);
	// One source-alpha blend carrying both: the body transmits (a), the reflection sits on top (F).
	float aOut = a + F * (1.0 - a);
	const float3 premul = body * (a * (1.0 - F)) + refl * F + glint;
	aOut = max(aOut, saturate(dot(glint, kLuma)));
	coverage = saturate(aOut);
	return premul / max(aOut, 1e-3);
}

#endif
