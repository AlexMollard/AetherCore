#ifndef AETHER_FOLIAGE_SLANGH
#define AETHER_FOLIAGE_SLANGH

// FoliageSkyLook (logs/look/FoliageSkyLook/README.md): wind on the scenery foliage. Shared by
// every pass that places vertices (forward DefaultVertex, prepass/shadow DepthVertex), so a
// swaying card's depth, shadow and colour all come from the same position.
// Requires FrameConstants.slangh and GpuMaterial.slangh.

// Scenery foliage: PS2 prelit cutout cards (foliage + baked_lighting) that are not the sky dome.
// The foliage flag alone also marks object-lit actors (butterflies, bats, tribesmen, hay bales,
// the piranha plant): those animate themselves and are never swayed.
bool IsSceneryFoliage(uint flags)
{
    return (flags & (kFlagFoliage | kFlagBakedLighting | kFlagSky)) == (kFlagFoliage | kFlagBakedLighting);
}

// graphics.foliageSkyLook: 1 = the full look, 0 = the PS2-faithful look (and the A/B switch).
float FoliageSkyLookStrength(FrameConstantsData* fc)
{
    return saturate(fc->shadingParams.w);
}

// How much a vertex sways, from its world normal: cards lying flat on the ground (the sawtooth
// grass fringe along the sand) stay still, so they never swim over the ground they lie on;
// upright and tilted cards (tufts, fronds, canopy leaves) sway fully. Deliberately not from the
// UV: vertices split at a card seam share a position but not a UV, and a UV-weighted offset tore
// cracks along the seams. Split vertices keep the normal across a flat seam, and the narrow band
// only separates near-flat from tilted, so a crease can crack only where a flat card meets a
// steep one. ponytail: a per-vertex sway weight from tw-extract (the card's base) would plant
// the tuft bases exactly; today a tuft's base shifts by the same few cm as its tip, less the flutter.
float FoliageSwayWeight(float3 worldNormal)
{
    const float len2 = dot(worldNormal, worldNormal);
    const float up = len2 > 1e-12f ? abs(worldNormal.y) * rsqrt(len2) : 0.0f;
    return 1.0f - smoothstep(0.85f, 0.98f, up);
}

// ponytail: every k* here is a look choice judged on the sheets, not measured - the PS2 had no wind.
static const float2 kWindDir = float2(0.8f, 0.6f); // unit, world xz: the sea breeze
static const float kWindSway = 0.05f;              // metres of lean at the top of a gust
static const float kWindFlutter = 0.012f;          // metres of per-leaf flutter
static const float kWindGustWavenumber = 0.045f;   // 1/m: gusts ~140 m apart roll across the level
static const float kWindGustSpeed = 0.5f;          // rad/s of the gust wave

// World-space offset for a vertex at `worldPos` (unswayed) whose normal, through the model's
// linear part, is `worldNormal` (unnormalised). A function of position and normal only, so the
// vertices split along a seam move together. Every pass must pass the same expressions.
// Visual only: colliders are built from the mesh on the CPU and never see it.
float3 FoliageWindOffset(FrameConstantsData* fc, uint materialIndex, float3 worldPos, float3 worldNormal)
{
    if (materialIndex == kNoTexture)
    {
        return float3(0.0f, 0.0f, 0.0f);
    }
    const float look = FoliageSkyLookStrength(fc);
    const uint flags = ((GpuMaterial*)(fc->materialBufferAddr))[materialIndex].flags;
    if (look <= 0.0f || !IsSceneryFoliage(flags))
    {
        return float3(0.0f, 0.0f, 0.0f);
    }
    const float t = fc->elapsedTime;
    const float along = dot(worldPos.xz, kWindDir);
    // A slow gust wave travelling downwind scales everything, so a field of grass leans in waves.
    const float gust = 0.55f + 0.45f * sin(along * kWindGustWavenumber - t * kWindGustSpeed);
    // The lean: two incommensurate periods so it never loops visibly; phase follows the wind and
    // height, so a tuft's tip lags its base (it bends rather than slides).
    const float sway = 0.7f * sin(t * 1.4f - along * 0.3f - worldPos.y * 1.2f) + 0.3f * sin(t * 2.3f - along * 0.8f + worldPos.y * 0.6f);
    // Flutter: a fast, spatially incoherent shiver per vertex (neighbouring leaves disagree).
    const float flutter = sin(t * 6.1f + dot(worldPos, float3(3.1f, 2.3f, 2.7f)));
    float3 offset = float3(kWindDir.x, 0.0f, kWindDir.y) * (kWindSway * gust * sway);
    offset += float3(0.6f, 1.0f, -0.8f) * (kWindFlutter * gust * flutter);
    return offset * (FoliageSwayWeight(worldNormal) * look);
}

#endif
