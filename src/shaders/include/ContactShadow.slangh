#ifndef AETHER_CONTACT_SHADOW_SLANGH
#define AETHER_CONTACT_SHADOW_SLANGH

// Screen-space contact shadows.
//
// A shadow map has one texel per some patch of the world, and a cascade covering
// a large view distance has coarse texels near the camera. Everything smaller
// than a texel is invisible to it: the gap under a foot, the seam where a prop
// meets the floor, the shadow a thin object casts on the surface right behind
// it. The result reads as objects hovering a few centimetres above the ground,
// and no amount of extra shadow resolution fixes it at a sane memory cost,
// because the detail wanted is sub-texel by definition.
//
// The depth buffer, though, already holds the scene at exactly the resolution
// the eye is looking at it. Marching a short ray toward the light through that
// buffer recovers precisely the contact-scale occlusion the cascade cannot
// resolve - and only there, because the ray is deliberately short.
//
// This is not a replacement for the cascades. It is a small multiplier on top,
// covering the last few centimetres they cannot.

// Ray length in world units. Long enough to close a contact gap, short enough
// that the march never wanders far enough to hit the classic screen-space
// failure of shadowing against geometry that is simply nearer the camera.
#include "ContactShadowMath.slangh"
float ContactShadow(float3 worldPos, float3 N, float3 L, FrameConstantsData* fc, float2 pixelCoord)
{
	const ResourceEntry depth = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_SceneDepth);
	if (depth.type != kResourceTypeBindlessTexture || depth.address == 0xFFFFFFFFu || depth.width == 0 || depth.height == 0) { return 1; }
	return SharedContactShadow(worldPos, N, L, fc->viewProj, fc->invViewProj, g_textures[uint(depth.address)], pixelCoord);
}
#endif
