#ifndef AETHER_DIRECTIONAL_SHADOW_CSM_SLANGH
#define AETHER_DIRECTIONAL_SHADOW_CSM_SLANGH

// Shared directional shadow helpers for cascaded shadow maps (CSM).
//
// Requirements in the including shader:
// - g_textures[] bindless Texture2D array
// - FrameConstantsData from FrameConstants.slangh

float ComputeDirectionalShadowCascade(
    FrameConstantsData* fc,
    uint cascadeIdx,
    float3 worldPos,
    float3 worldNormal,
    float3 lightDir)
{
    ResourceEntry entry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_DirectionalShadowC0 + cascadeIdx);
    const uint shadowSlot = uint(entry.address);
    if (entry.type != kResourceTypeBindlessTexture || shadowSlot == 0xFFFFFFFFu || entry.width == 0u || entry.height == 0u)
    {
        return 1.0;
    }

    const float3 N = normalize(worldNormal);
    const float3 L = normalize(lightDir);
    const float NdotL = dot(N, L);
    if (NdotL <= 0.0)
    {
        // Backface to the light: the lighting term already zeroes this out, and biasing a
        // surface that steep only eats into the shadow of whatever stands on it.
        return 1.0;
    }

    // Normal-offset bias: move the lookup off the surface along its own normal rather
    // than pushing the receiver's depth toward the light. A depth push shifts the whole
    // silhouette down the light direction, which is what detaches a shadow from its
    // caster's feet; sliding along the normal stays in the same plane as the surface, so
    // the contact edge holds. Scaled by sin(theta) because that is exactly how far the
    // shadow texel's depth can drift across the footprint of a slanted surface.
    const float sinTheta = sqrt(saturate(1.0 - NdotL * NdotL));
    const float3 samplePos = worldPos + N * (fc->shadowCascadeNormalOffset[cascadeIdx] * sinTheta);

    const float4 clip = mul(fc->shadowViewProjCascades[cascadeIdx], float4(samplePos, 1.0));
    if (abs(clip.w) < 1e-6)
    {
        return 1.0;
    }

    float3 ndc = clip.xyz / clip.w;
    float2 uv = ndc.xy * 0.5 + 0.5;
    if (uv.x <= 0.0 || uv.x >= 1.0 || uv.y <= 0.0 || uv.y >= 1.0)
    {
        return 1.0;
    }
    if (ndc.z <= 0.0 || ndc.z >= 1.0)
    {
        return 1.0;
    }

    const float receiverDepth = saturate(ndc.z);
    // One number, already expressed in this cascade's NDC depth units on the CPU from its
    // real texel size and ortho depth range - no ad-hoc per-cascade multiplier.
    const float bias = fc->shadowCascadeDepthBias[cascadeIdx];

    const uint shadowW = entry.width;
    const uint shadowH = entry.height;
    const float2 texel = 1.0 / float2((float)shadowW, (float)shadowH);
    const float pcfRadiusTexels = max(fc->shadowParams.w, 0.5);

    float visibility = 0.0;
    float weightSum = 0.0;
    [unroll]
    for (int y = -2; y <= 2; ++y)
    {
        [unroll]
        for (int x = -2; x <= 2; ++x)
        {
            const float2 offset = float2((float)x, (float)y) * texel * pcfRadiusTexels;
            const float2 sampleUv = uv + offset;
            if (sampleUv.x <= 0.0 || sampleUv.x >= 1.0 || sampleUv.y <= 0.0 || sampleUv.y >= 1.0)
            {
                continue;
            }

            const float2 dist = abs(float2((float)x, (float)y));
            const float wx = max(0.0, 3.0 - dist.x);
            const float wy = max(0.0, 3.0 - dist.y);
            const float w = wx * wy;

            // Point fetch, not a filtered one: hardware linear filtering averages the stored
            // depths before the comparison, so across a silhouette the occluder's depth is
            // blended toward the receiver's and the shadow loses another texel of edge. PCF
            // has to filter the comparison results, which is what the weights below do.
            const int2 texelCoord = clamp(int2(floor(sampleUv * float2((float)shadowW, (float)shadowH))), int2(0, 0), int2((int)shadowW - 1, (int)shadowH - 1));
            const float shadowDepth = g_textures[shadowSlot].Load(int3(texelCoord, 0)).r;
            visibility += ((receiverDepth - bias <= shadowDepth) ? 1.0 : 0.0) * w;
            weightSum += w;
        }
    }

    return (weightSum > 0.0) ? (visibility / weightSum) : 1.0;
}

    float ComputeDirectionalShadow(FrameConstantsData* fc, float3 worldPos, float3 worldNormal, float3 lightDir)
{
    const float viewDepth = max(-mul(fc->view, float4(worldPos, 1.0)).z, 0.0);
    const float split0 = fc->shadowCascadeSplits.x;
    const float split1 = fc->shadowCascadeSplits.y;

    uint cascade = 0u;
    if (viewDepth > split0)
    {
        cascade = 1u;
    }
    if (viewDepth > split1)
    {
        cascade = 2u;
    }

    // Wider blend regions reduce visible seams by cross-fading over a larger
    // depth range.  The orthographic frustums also overlap (kCascadeOverlap)
    // so that blend samples stay inside the neighbour cascade's valid map area.
    const float blendWidth0 = max(split0 * 0.32, 8.0);
    const float blendWidth1 = max((split1 - split0) * 0.32, 10.0);

    float shadow = ComputeDirectionalShadowCascade(fc, cascade, worldPos, worldNormal, lightDir);

    if (cascade == 0u)
    {
        const float t = smoothstep(split0 - blendWidth0, split0, viewDepth);
        if (t > 0.0)
        {
            const float shadow1 = ComputeDirectionalShadowCascade(fc, 1u, worldPos, worldNormal, lightDir);
            shadow = lerp(shadow, shadow1, t);
        }
    }
    else if (cascade == 1u)
    {
        const float t0 = 1.0 - smoothstep(split0, split0 + blendWidth0, viewDepth);
        if (t0 > 0.0)
        {
            const float shadow0 = ComputeDirectionalShadowCascade(fc, 0u, worldPos, worldNormal, lightDir);
            shadow = lerp(shadow, shadow0, t0);
        }

        const float t1 = smoothstep(split1 - blendWidth1, split1, viewDepth);
        if (t1 > 0.0)
        {
            const float shadow2 = ComputeDirectionalShadowCascade(fc, 2u, worldPos, worldNormal, lightDir);
            shadow = lerp(shadow, shadow2, t1);
        }
    }
    else
    {
        const float t = 1.0 - smoothstep(split1, split1 + blendWidth1, viewDepth);
        if (t > 0.0)
        {
            const float shadow1 = ComputeDirectionalShadowCascade(fc, 1u, worldPos, worldNormal, lightDir);
            shadow = lerp(shadow, shadow1, t);
        }
    }

    return shadow;
}

#endif
