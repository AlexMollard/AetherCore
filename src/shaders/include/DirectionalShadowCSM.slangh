#ifndef AETHER_DIRECTIONAL_SHADOW_CSM_SLANGH
#define AETHER_DIRECTIONAL_SHADOW_CSM_SLANGH

// Shared directional shadow helpers for cascaded shadow maps (CSM).
//
// Requirements in the including shader:
// - g_textures[] bindless Texture2D array
// - FrameConstantsData from FrameConstants.slangh

// Tap counts. Cost in the forward shader is close to linear in these, and halving
// them takes 27% off that pass while changing 0.4% of pixels by more than 4/255 -
// all of it inside penumbra edges. The blocker search only has to estimate an
// average occluder depth, which is coarse by nature, so it is the cheaper half to
// economise on.
static const uint kCsmBlockerSamples = 6u;
static const uint kCsmFilterSamples = 8u;

// Widest blocker search, in texels. The sun subtends about half a degree, so a blocker
// a metre above a receiver throws a penumbra under a centimetre wide - tens of texels is
// far wider than any penumbra the sun can cast. On a character it just finds that
// character's own head, arm and shoulder as blockers, the penumbra estimate explodes,
// and the filter fans out across the body's own depth range, which reads as stippled
// self-shadow acne. Bounding it bounds the search cost too.
static const float kMaxPenumbraTexels = 6.0;

// Fraction of a cascade's own depth range spent fading into the next one.
static const float kCascadeBlendFraction = 0.15;

// Point fetch, clamped to the map. Filtering happens on the comparison results.
float LoadCascadeDepth(uint shadowSlot, float2 uv, uint width, uint height)
{
    const int2 maxTexel = int2((int)width - 1, (int)height - 1);
    const int2 texel = clamp(int2(floor(uv * float2((float)width, (float)height))), int2(0, 0), maxTexel);
    return g_textures[shadowSlot].Load(int3(texel, 0)).r;
}

float ComputeDirectionalShadowCascade(
    FrameConstantsData* fc,
    uint cascadeIdx,
    float3 worldPos,
    float3 worldNormal,
    float3 lightDir,
    float2 pixelCoord)
{
    ResourceEntry entry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_DirectionalShadowC0 + cascadeIdx);
    const uint shadowSlot = uint(entry.address);
    if (entry.type != kResourceTypeBindlessTexture || shadowSlot == 0xFFFFFFFFu || entry.width == 0u || entry.height == 0u)
    {
        return 1.0;
    }

    const float3 N = normalize(worldNormal);
    const float3 L = normalize(lightDir);
    const float NdotL = dot(N, L);
    if (NdotL <= 0.0)
    {
        // Backface to the light: the lighting term already zeroes this out, and biasing a
        // surface that steep only eats into the shadow of whatever stands on it.
        return 1.0;
    }

    // Normal-offset bias: move the lookup off the surface along its own normal rather
    // than pushing the receiver's depth toward the light. A depth push shifts the whole
    // silhouette down the light direction, which is what detaches a shadow from its
    // caster's feet; sliding along the normal stays in the same plane as the surface, so
    // the contact edge holds. Scaled by sin(theta) because that is exactly how far the
    // shadow texel's depth can drift across the footprint of a slanted surface.
    const float sinTheta = sqrt(saturate(1.0 - NdotL * NdotL));
    const float3 samplePos = worldPos + N * (fc->shadowCascadeNormalOffset[cascadeIdx] * sinTheta);

    const float4 clip = mul(fc->shadowViewProjCascades[cascadeIdx], float4(samplePos, 1.0));
    if (abs(clip.w) < 1e-6)
    {
        return 1.0;
    }

    float3 ndc = clip.xyz / clip.w;
    float2 uv = ndc.xy * 0.5 + 0.5;
    if (uv.x <= 0.0 || uv.x >= 1.0 || uv.y <= 0.0 || uv.y >= 1.0)
    {
        return 1.0;
    }
    if (ndc.z <= 0.0 || ndc.z >= 1.0)
    {
        return 1.0;
    }

    const float receiverDepth = saturate(ndc.z);
    // One number, already expressed in this cascade's NDC depth units on the CPU from its
    // real texel size and ortho depth range - no ad-hoc per-cascade multiplier.
    const float bias = fc->shadowCascadeDepthBias[cascadeIdx];

    const float2 texel = 1.0 / float2((float)entry.width, (float)entry.height);
    const float maxTexel = max(texel.x, texel.y);

    // Penumbra geometry, not a filter-width constant: the sun's angular radius says
    // how wide a blocker's shadow spreads per unit of depth separation. That is what
    // keeps the softness physically tied to the scene instead of to how far the
    // camera happens to be from the cascade.
    const float penumbraScale = fc->shadowCascadePenumbraScale[cascadeIdx];
    const float searchRadiusUv = min(penumbraScale, kMaxPenumbraTexels * maxTexel);
    const float phi = InterleavedGradientNoise(pixelCoord) * kTwoPi;

    // Stage 1: how far in front of this receiver do the occluders sit?
    float blockerSum = 0.0;
    float blockerCount = 0.0;
    [unroll]
    for (uint i = 0u; i < kCsmBlockerSamples; ++i)
    {
        const float2 sampleUv = uv + VogelDiskSample(i, kCsmBlockerSamples, phi) * searchRadiusUv;
        const float d = LoadCascadeDepth(shadowSlot, sampleUv, entry.width, entry.height);
        if (d < receiverDepth - bias)
        {
            blockerSum += d;
            blockerCount += 1.0;
        }
    }

    if (blockerCount <= 0.0)
    {
        return 1.0;
    }

    // Stage 2: penumbra width. Collapses to a single texel as the blocker meets the
    // receiver, which is the contact hardening - sharp at the caster's base, soft
    // where the caster is far above it.
    const float avgBlocker = blockerSum / blockerCount;
    const float filterRadiusUv = clamp((receiverDepth - avgBlocker) * penumbraScale, maxTexel, searchRadiusUv);

    // Stage 3: filter the comparison results, never the stored depths. Hardware
    // linear filtering would average the depths first, which across a silhouette
    // blends the occluder's depth toward the receiver's and eats the edge.
    float visibility = 0.0;
    [unroll]
    for (uint j = 0u; j < kCsmFilterSamples; ++j)
    {
        const float2 sampleUv = uv + VogelDiskSample(j, kCsmFilterSamples, phi) * filterRadiusUv;
        const float d = LoadCascadeDepth(shadowSlot, sampleUv, entry.width, entry.height);
        visibility += ((receiverDepth - bias) <= d) ? 1.0 : 0.0;
    }

    return visibility / float(kCsmFilterSamples);
}

float ComputeDirectionalShadow(FrameConstantsData* fc, float3 worldPos, float3 worldNormal, float3 lightDir, float2 pixelCoord)
{
    const float viewDepth = max(-mul(fc->view, float4(worldPos, 1.0)).z, 0.0);
    const float split0 = fc->shadowCascadeSplits.x;
    const float split1 = fc->shadowCascadeSplits.y;

    uint cascade = 0u;
    if (viewDepth > split0)
    {
        cascade = 1u;
    }
    if (viewDepth > split1)
    {
        cascade = 2u;
    }

    // Cross-fade into the next cascade over the tail of this one, and only from the
    // near side. Giving the far cascade a mirrored fade back toward the near one made
    // the two swap places across the split - fully cascade N+1 just before it, fully
    // cascade N just after - which is a hard step dressed up as a blend. One directed
    // fade is continuous at the boundary by construction.
    //
    // The next cascade covers this stretch already: its fitted sphere is centred near
    // its own far plane with a radius larger than its slice, so it reaches back well
    // past the split (see FitCascadeSphere in ShadowService.cpp).
    float shadow = ComputeDirectionalShadowCascade(fc, cascade, worldPos, worldNormal, lightDir, pixelCoord);

    if (cascade < 2u)
    {
        const float splitFar = (cascade == 0u) ? split0 : split1;
        const float splitNear = (cascade == 0u) ? 0.0 : split0;
        const float blendWidth = max((splitFar - splitNear) * kCascadeBlendFraction, 2.0);
        const float t = smoothstep(splitFar - blendWidth, splitFar, viewDepth);
        if (t > 0.0)
        {
            const float next = ComputeDirectionalShadowCascade(fc, cascade + 1u, worldPos, worldNormal, lightDir, pixelCoord);
            shadow = lerp(shadow, next, t);
        }
    }

    return shadow;
}

#endif
