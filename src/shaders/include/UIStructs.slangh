#ifndef AETHER_UI_STRUCTS_SLANGH
#define AETHER_UI_STRUCTS_SLANGH

#include "DevicePointer.slangh"

struct DrawCommandData
{
    float4 data0;        // Rect: x,y,w,h | Circle: cx,cy,r,0 | Line: x0,y0,x1,y1
    float4 data1;        // Rect/Line: cornerRadius/thickness | TexturedRect: u0,v0,u1,v1
    float4 color;        // RGBA tint
    float4 clipRect;     // x,y,w,h px; honoured only when (flags & 4) is set
    uint   type;
    int    layer;
    uint   textureSlot;  // bindless slot (TexturedRect only)
    // bit 0 = pixel-art (nearest) sampling; bit 1 = exclude from the owning element's material
    // (build-time only, stripped before upload, so it is never seen here); bit 2 = honour clipRect;
    // bits 8..15 = shaderId, a per-frame index into the material table (0 = default ui_shapes
    // fragment). Mirrors UiDrawCommand::flags in src/engine/ui/UiDrawCommand.hpp.
    uint   flags;
};

struct DrawIndirectCommand
{
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

#endif
