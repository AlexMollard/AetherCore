#ifndef AETHER_SKY_SLANGH
#define AETHER_SKY_SLANGH

// Procedural sky, shared by the skybox pass and by image-based lighting in the
// forward shader so both see exactly the same environment.
//
// Split deliberately in two:
//   SkyGradient - the smooth atmosphere alone. This is what surfaces are lit BY,
//                 and it is the only half safe to use as an environment probe.
//   EvalSky     - the gradient plus the solar disk, horizon glow and stars: what
//                 the camera SEES. Lighting a surface with these would double
//                 count the sun, which the direct lighting term already applies,
//                 and would paint a second sun onto every glossy surface.

float Hash31(float3 p)
{
    return frac(sin(dot(p, float3(127.1f, 311.7f, 74.3f))) * 43758.5f);
}

float Hash12(float2 p)
{
    return frac(sin(dot(p, float2(127.1f, 311.7f))) * 43758.5453f);
}

float Smooth5(float x)
{
    x = saturate(x);
    return x * x * x * (x * (x * 6.0f - 15.0f) + 10.0f);
}

float StarField(float3 dir)
{
    const float3 cell = floor(dir * 180.0f);
    float star = smoothstep(0.997f, 1.0f, Hash31(cell));
    star *= saturate(dir.y + 0.1f); // hide below the horizon
    return star;
}

// Single-scattering atmosphere, as an alternative to the authored gradient.
//
// The gradient is a lerp between two colours somebody picked. It cannot produce
// the things that make a real sky read as sky: the horizon warming while the
// zenith stays deep, the halo tightening as the sun climbs, the whole vault
// shifting red at sunset because the light is travelling through more air. Those
// all come from one fact - air scatters short wavelengths far more than long
// ones - and once that is modelled they fall out together instead of having to
// be authored one by one.
//
// Rayleigh coefficients are the 1/lambda^4 dependence evaluated at roughly the
// sRGB primaries, which is why blue is scattered about six times as strongly as
// red. Mie is aerosol scattering: wavelength-independent, strongly forward, and
// what makes the sun's surroundings glow white rather than blue.
//
// Single scattering only. Multiple scattering is what keeps a real sky from going
// black at the zenith and fills shadowed air at dusk; approximating it as a small
// ambient floor is far cheaper than integrating it and is most of the way there.
static const float3 kRayleighBeta = float3(5.8e-6f, 13.5e-6f, 33.1e-6f);
static const float  kMieBeta = 21e-6f;
// Forward asymmetry of aerosol scattering; 0.76 is the usual fit for haze.
static const float  kMieG = 0.76f;

// Relative air mass along a view ray. The closed form is Kasten and Young's fit:
// straight up the path is one atmosphere, at the horizon it is nearly forty, and
// a plain 1/cos blows up before it gets there.
float AirMass(float cosZenith)
{
	const float z = degrees(acos(clamp(cosZenith, -1.0f, 1.0f)));
	return 1.0f / (max(cosZenith, 0.0f) + 0.15f * pow(max(93.885f - z, 1e-3f), -1.253f));
}

float3 PhysicalSky(
	float3 worldDir,
	float3 sunDir,
	float3 sunColor,
	float  sunIntensity,
	float  turbidity,
	float3 voidColor)
{
	const float cosTheta = dot(normalize(worldDir), normalize(sunDir));

	// Rayleigh is symmetric front to back; Mie is a narrow forward lobe, which is
	// the halo around the sun.
	const float rayleighPhase = (3.0f / (16.0f * 3.14159265f)) * (1.0f + cosTheta * cosTheta);
	const float g2 = kMieG * kMieG;
	const float mieDenom = pow(max(1.0f + g2 - 2.0f * kMieG * cosTheta, 1e-4f), 1.5f);
	const float miePhase = (3.0f / (8.0f * 3.14159265f)) * ((1.0f - g2) * (1.0f + cosTheta * cosTheta)) / ((2.0f + g2) * mieDenom);

	// How much air this ray and the sunlight reaching it each pass through. The sun
	// term is why a low sun reddens everything: its own light is filtered before it
	// ever reaches the air being looked at.
	const float viewMass = AirMass(worldDir.y);
	const float sunMass = AirMass(sunDir.y);

	// Turbidity scales the aerosol load; Rayleigh is a property of the air itself.
	const float3 betaR = kRayleighBeta * 8000.0f;
	const float3 betaM = float3(kMieBeta, kMieBeta, kMieBeta) * 1200.0f * max(turbidity, 1.0f);

	const float3 opticalDepth = betaR * viewMass + betaM * viewMass;
	const float3 sunTransmit = exp(-(betaR * sunMass + betaM * sunMass));
	const float3 extinction = 1.0f - exp(-opticalDepth);

	const float3 scatter = (betaR * rayleighPhase + betaM * miePhase) / max(betaR + betaM, 1e-8f);
	float3 sky = scatter * extinction * sunTransmit * sunColor * sunIntensity;

	// Stand-in for multiple scattering, so the zenith keeps a little colour and dusk
	// does not fall to black the instant the sun sets.
	sky += betaR / max(betaR + betaM, 1e-8f) * 0.02f * saturate(sunDir.y + 0.3f) * sunColor * sunIntensity;

	// Same near-black floor below the horizon the gradient uses, so ground-facing
	// reflections and the lower hemisphere agree between the two models.
	const float voidBlend = 1.0f - smoothstep(-0.22f, -0.015f, worldDir.y);
	return lerp(max(sky, 0.0f), voidColor, voidBlend);
}

// The atmosphere without the sun disk or stars: safe to treat as incoming radiance.
float3 SkyGradient(
    float3 worldDir,
    float3 sunDir,
    float3 sunColor,
    float  sunIntensity,
    float3 horizonColor,
    float3 zenithColor,
    float3 voidColor,
    float4 skyParams)
{
    // One entry point, so the skybox, the image-based ambient and the fog colour all
    // move together the moment a scene switches model. They read the same sky by
    // construction rather than by three call sites being kept in agreement.
    if (skyParams.x > 0.5f)
    {
        return PhysicalSky(worldDir, sunDir, sunColor, sunIntensity, skyParams.y, voidColor);
    }

    const float sunAltitude = saturate(sunDir.y);
    const float nightAmount = 1.0f - smoothstep(-0.10f, 0.25f, sunDir.y);
    const float dayAmount   = 1.0f - nightAmount;
    const float lowSunAmount = 1.0f - smoothstep(0.08f, 0.55f, sunAltitude);

    // Smooth horizon -> zenith gradient to avoid visible daytime band seams.
    const float t       = saturate(worldDir.y * 0.5f + 0.5f);
    const float3 warmHorizon = horizonColor + float3(0.20f, 0.08f, 0.02f) * lowSunAmount;
    const float3 zenith = zenithColor * lerp(1.0f, 0.45f, nightAmount);

    // Broader transition so the horizon rolls into the sky more gradually.
    const float gradientBlend = smoothstep(-0.10f, 0.95f, t);
    float3 sky = lerp(warmHorizon, zenith, Smooth5(gradientBlend));

    // Gentle atmospheric haze hugging the horizon to further soften the junction.
    const float horizonHaze = exp2(-18.0f * abs(worldDir.y));
    sky = lerp(sky, warmHorizon, horizonHaze * (0.16f + 0.10f * lowSunAmount));

    // Daytime cyan lift around mid-elevations to keep noon sky lively.
    const float midBand = saturate(1.0f - abs(t * 2.0f - 1.0f) * 1.35f);
    sky += float3(0.0f, 0.018f, 0.055f) * midBand * dayAmount;

    // Below the horizon: darken gently to avoid a sharp cutoff.
    const float belowHorizon = saturate(-worldDir.y * 2.0f);
    sky = lerp(sky, sky * 0.15f, belowHorizon);

    // Force a near-black void below the horizon.
    // Keep a small transition band to avoid hard aliasing at exactly y=0.
    const float voidBlend = 1.0f - smoothstep(-0.22f, -0.015f, worldDir.y);
    sky = lerp(sky, voidColor, voidBlend);

    return sky;

    return sky;
}

// The sky as the camera sees it: gradient plus everything emissive in it.
float3 EvalSky(
    float3 worldDir,
    float3 sunDir,
    float3 sunColor,
    float  sunIntensity,
    float3 horizonColor,
    float3 zenithColor,
    float3 voidColor,
    float4 skyParams)
{
    float3 sky = SkyGradient(worldDir, sunDir, sunColor, sunIntensity, horizonColor, zenithColor, voidColor, skyParams);

    const float sunAltitude = saturate(sunDir.y);
    const float nightAmount = 1.0f - smoothstep(-0.10f, 0.25f, sunDir.y);
    const float lowSunAmount = 1.0f - smoothstep(0.08f, 0.55f, sunAltitude);

    // Smooth solar radiance profile (core + corona) to avoid hard concentric bands.
    const float cosAngle = saturate(dot(worldDir, sunDir));
    const float d = 1.0f - cosAngle; // angular distance proxy near the sun

    // Multi-lobe falloff gives a natural-looking bright core with soft bloom.
    const float sunCore   = exp2(-26000.0f * d);
    const float sunInner  = exp2(-2600.0f  * d);
    const float sunOuter  = exp2(-260.0f   * d);
    const float sunCorona = exp2(-70.0f    * d);

    // Lower sun altitude shifts the disk and halo warmer.
    const float3 diskColor  = lerp(
        float3(1.6f, 0.6f, 0.2f),
        float3(1.5f, 1.35f, 1.1f),
        sunAltitude);
    const float3 haloColor  = lerp(
        float3(1.0f, 0.3f, 0.05f),
        float3(1.0f, 0.65f, 0.25f),
        sunAltitude);

    // Keep the core bright and warm, while the wider corona stays softer.
    const float3 sunCoreColor = diskColor * sunColor;
    const float3 sunHaloColor = haloColor * sunColor;
    sky += sunCoreColor * sunIntensity * ((2.8f * sunCore) + (0.90f * sunInner));
    sky += sunHaloColor * sunIntensity * ((0.28f * sunOuter) + (0.10f * sunCorona));

    // The sky brightens along the entire horizon in the sun's azimuth,
    // not just at the solar disk itself.
    const float2 worldDirXZ = worldDir.xz / max(length(worldDir.xz), 1e-4f);
    const float2 sunDirXZ   = sunDir.xz   / max(length(sunDir.xz),   1e-4f);
    const float  azimuthDot = dot(worldDirXZ, sunDirXZ);
    const float  horizonMask = saturate(1.0f - abs(worldDir.y) * 6.0f);
    const float  horizonGlow = smoothstep(0.55f, 1.0f, azimuthDot) * horizonMask * (0.35f * lowSunAmount);
    sky += horizonGlow * lerp(
        float3(1.0f, 0.4f, 0.1f),
        float3(1.0f, 0.8f, 0.5f),
        sunAltitude) * sunColor * sunIntensity;

    // Subtle forward-scatter streak near sunrise/sunset (not a lens flare).
    const float streakHorizonMask = smoothstep(-0.03f, 0.20f, worldDir.y) *
                                    (1.0f - smoothstep(0.20f, 0.55f, worldDir.y));
    const float streakAzimuth = smoothstep(0.70f, 1.0f, azimuthDot);
    const float streakForward = smoothstep(0.86f, 1.0f, cosAngle);
    const float sunStreak = 0.08f * lowSunAmount * streakHorizonMask * streakAzimuth * streakForward;
    sky += sunHaloColor * sunIntensity * sunStreak;

    // At night, darken the sky aggressively to make the cycle more obvious.
    sky *= lerp(1.0f, 0.18f, nightAmount);

    // Cheap night stars.
    sky += StarField(worldDir) * nightAmount * float3(0.9f, 0.95f, 1.0f);

    // Force a near-black void below the horizon.
    // Keep a small transition band to avoid hard aliasing at exactly y=0.
    const float voidBlend = 1.0f - smoothstep(-0.22f, -0.015f, worldDir.y);
    sky = lerp(sky, voidColor, voidBlend);

    return sky;

    return sky;
}

#endif
