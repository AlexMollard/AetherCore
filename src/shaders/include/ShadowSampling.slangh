#ifndef AETHER_SHADOW_SAMPLING_SLANGH
#define AETHER_SHADOW_SAMPLING_SLANGH

// Sampling primitives shared by the directional cascades and the local shadow
// atlas, so both filter their shadows the same way and a change to the pattern
// cannot drift between them.

// Vogel disk. Even areal coverage without the clumping a jittered grid gives,
// and generated in closed form so there is no sample table to keep in sync.
float2 VogelDiskSample(uint index, uint count, float phi)
{
    const float goldenAngle = 2.39996323;
    float r = sqrt((float(index) + 0.5) / float(count));
    float theta = float(index) * goldenAngle + phi;
    return float2(r * cos(theta), r * sin(theta));
}

// Interleaved gradient noise (Jimenez). One rotation angle per pixel, stable
// under camera motion, without the swimming a per-frame random hash produces.
// Rotating the disk per pixel turns undersampling into fine dither instead of
// the banded rings a fixed pattern would show.
float InterleavedGradientNoise(float2 pixelCoord)
{
    const float3 magic = float3(0.06711056, 0.00583715, 52.9829189);
    return frac(magic.z * frac(dot(pixelCoord, magic.xy)));
}

static const float kTwoPi = 6.28318531;

#endif
