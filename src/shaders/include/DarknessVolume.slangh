#ifndef AETHER_DARKNESS_VOLUME_SLANGH
#define AETHER_DARKNESS_VOLUME_SLANGH

// Darkness volumes (DarknessVolumeComponent): boxes that fade what is seen inside them to
// black with depth below their top face - the black a PS2 pit had at its bottom.
//
// The fade follows the view ray, not just the shaded point. The part of the segment from the
// eye to the surface that lies inside the box is found by slab clipping, and its deepest point
// sets the darkness. For a surface inside the pit that is the surface itself (a wall or floor
// darkens with its depth, Crash falling in darkens as he drops), and for anything seen THROUGH
// the pit's open bottom (sky, sea far below) it is where the ray leaves the box, so the hole
// reads black instead of showing what is under the level. A ray that misses every box, or only
// grazes one along its top, is untouched: nothing outside a pit changes.

#include "FrameConstants.slangh"

// Fraction of the radiance the volumes swallow along the ray eye -> surface, 0 = none.
#include "SceneVolumeMath.slangh"
float DarknessVolumeAmount(FrameConstantsData* fc, float3 eye, float3 surface)
{
	return SharedDarknessVolumeAmount(fc->darknessVolumeInfo.x, fc->darknessVolumes, eye, surface);
}

#endif
