#ifndef AETHER_GPU_MATERIAL_SLANGH
#define AETHER_GPU_MATERIAL_SLANGH

// Must stay binary-compatible with aether::GpuMaterial (80 bytes).

static const uint kNoTexture       = 0xFFFFFFFFu;
static const uint kFlagDoubleSided = 1u;
static const uint kFlagAlphaBlend  = 2u;
static const uint kFlagAlphaMask   = 4u;
static const uint kFlagModulateVertexColor = 8u;
static const uint kFlagNoReceiveShadows = 16u; // set == material opts out of shadow receiving
static const uint kFlagFoliage = 32u; // PS2 foliage/cutout card: no shadow maps
static const uint kFlagBakedLighting = 64u; // PS2 prelit: vertex colour is the lighting
static const uint kFlagObjectLit = 128u;    // PS2 object lighting from the level's light records

struct GpuMaterial
{
    [[vk::offset(0)]]  float4 baseColorFactor;
    [[vk::offset(16)]] float  metallicFactor;
    [[vk::offset(20)]] float  roughnessFactor;
    [[vk::offset(24)]] float  occlusionStrength;
    [[vk::offset(28)]] float  alphaCutoff;
    [[vk::offset(32)]] float4 emissiveFactor;          // xyz = emissive RGB, w unused
    [[vk::offset(48)]] uint   flags;
    [[vk::offset(52)]] uint   albedoSlot;
    [[vk::offset(56)]] uint   normalSlot;
    [[vk::offset(60)]] uint   metallicRoughnessSlot;
    [[vk::offset(64)]] uint   occlusionSlot;
    [[vk::offset(68)]] uint   emissiveSlot;
    [[vk::offset(72)]] float2 uvScroll; // UV units per second, offset by elapsed time
};

#endif
