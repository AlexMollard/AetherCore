#ifndef AETHER_AMBIENT_OCCLUSION_SLANGH
#define AETHER_AMBIENT_OCCLUSION_SLANGH

// How much of the ambient hemisphere reaches this pixel.
//
// Two sources multiplied: the material's own baked occlusion texture, and the screen-space
// GTAO buffer this frame. Kept here rather than at the call site because the material graph
// generates a second shader that needs the identical answer - a surface lit by a different
// amount of ambient than the one beside it does not read as the same scene.
//
// Requires the including shader to declare the bindless heap (g_textures, g_linearSampler)
// and to have included RenderContracts.slangh and GpuMaterial.slangh.

// The material's baked occlusion, scaled by its strength. 1 when it has no occlusion map.
float MaterialOcclusion(in GpuMaterial mat, in float2 uv)
{
    if (mat.occlusionSlot == kNoTexture)
    {
        return 1.0f;
    }
    const float aoSample = g_textures[mat.occlusionSlot].Sample(g_linearSampler, uv).r;
    return lerp(1.0f, aoSample, mat.occlusionStrength);
}

// This frame's screen-space GTAO, or 1 when the pass did not run.
float GtaoVisibility(in FrameConstantsData* fc, in float2 pixelCoord)
{
    const ResourceEntry aoEntry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_Gtao);
    if (aoEntry.type != kResourceTypeBindlessTexture || aoEntry.address == 0xFFFFFFFFu || aoEntry.width == 0u || aoEntry.height == 0u)
    {
        return 1.0f;
    }
    const uint aoSlot = aoEntry.address;
    // The AO target is half resolution, so its own extent cannot be scaled up directly - that
    // would overshoot the true extent by a pixel when the scene extent is odd. The depth
    // target carries the full extent.
    const ResourceEntry sceneDepthEntry = LoadResourceEntry(fc->resourceTableAddr, kFrameResourceId_SceneDepth);
    const float2 fullExtent = (sceneDepthEntry.type == kResourceTypeBindlessTexture && sceneDepthEntry.width > 0u && sceneDepthEntry.height > 0u)
        ? float2(sceneDepthEntry.width, sceneDepthEntry.height)
        : float2(aoEntry.width, aoEntry.height) * 2.0f;
    const float2 aoUv = saturate(pixelCoord / fullExtent);
    return saturate(g_textures[aoSlot].Sample(g_linearSampler, aoUv).r);
}

// Ambient occlusion says how much of the hemisphere is blocked, and multiplying the ambient
// by it assumes the blocked directions deliver nothing at all. That is only true if the
// blockers are black. They are not: light that would have arrived from a blocked direction
// hits the nearby surface instead, bounces, and some of it still reaches the point - carrying
// that surface's colour with it. A corner in a white room is not black, and a corner in a red
// one goes red rather than grey. Straight multiplication has neither behaviour, which is what
// makes plain AO read as a dirty smudge painted onto the geometry rather than as light.
//
// Jimenez et al., "Practical Real-Time Strategies for Accurate Indirect Occlusion", fit a
// cubic to the ground-truth interreflection response as a function of albedo. Evaluated per
// channel it gives back occlusion that is both albedo-dependent and coloured, for a handful
// of ALU and no extra buffer. The max() keeps it from ever darkening more than the raw AO
// would, so it can only add back light that a bounce really would have delivered.
//
// Diffuse only. This is an interreflection model for a hemisphere gather; a specular lobe
// gathers one narrow direction, and SpecularOcclusion below is what describes that.
float3 MultiBounceAo(in float ao, in float3 albedo)
{
    const float3 a =  2.0404f * albedo - 0.3324f;
    const float3 b = -4.7951f * albedo + 0.6417f;
    const float3 c =  2.7552f * albedo + 0.6903f;
    return max(float3(ao, ao, ao), ((ao * a + b) * ao + c) * ao);
}

// Diffuse and specular are not occluded by the same amount. Diffuse gathers the whole
// hemisphere, so ambient occlusion describes it directly. A specular lobe gathers a cone
// whose width is set by roughness: the smoother the surface, the narrower that cone, and the
// less likely the geometry that occludes the hemisphere also occludes the one direction the
// reflection comes from. Applying the diffuse term to both over-darkens reflections on smooth
// surfaces inside any crease or contact, so polished materials go dull exactly where they
// should still catch light.
//
// Lagarde's approximation ("Moving Frostbite to Physically Based Rendering") reconstructs the
// cone's occlusion from the hemisphere's. At roughness 1 it returns the plain AO, because
// then the lobe IS the hemisphere.
float SpecularOcclusion(in float ambientAo, in float NdotV, in float roughness)
{
    return saturate(pow(NdotV + ambientAo, exp2(-16.0f * roughness - 1.0f)) - 1.0f + ambientAo);
}

#endif
