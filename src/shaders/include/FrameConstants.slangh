#ifndef AETHER_FRAME_CONSTANTS_SLANGH
#define AETHER_FRAME_CONSTANTS_SLANGH

#include "ResourceTable.slangh"

// Shared per-frame constants layout for Slang shaders.
// Keep this struct in lockstep with aether::FrameConstants in
// src/engine/FrameConstants.hpp.

struct FrameConstantsData
{
    [[vk::offset(0)]]   float4x4 viewProj;
    [[vk::offset(64)]]  float4x4 view;
    [[vk::offset(128)]] float4x4 proj;
    [[vk::offset(192)]] uint64_t materialBufferAddr;
    [[vk::offset(200)]] float elapsedTime;            // offset 204: uint32 _pad0 (not accessed in shaders)
    [[vk::offset(208)]] float4 sunDirectionIntensity; // xyz=world dir, w=intensity
    [[vk::offset(224)]] float4 ambientColor;          // rgb=ambient term, a=unused
    [[vk::offset(240)]] float4 cameraWorldPos;        // xyz=camera pos, w=1
    [[vk::offset(256)]] float4 sunColor;              // rgb=sun light color, a=unused
    [[vk::offset(272)]] float4 skyHorizonColor;       // rgb=sky horizon color, a=unused
    [[vk::offset(288)]] float4 skyZenithColor;        // rgb=sky zenith color, a=unused
    [[vk::offset(304)]] float4 skyVoidColor;          // rgb=sky void color, a=unused
    [[vk::offset(320)]] uint4  tiledLightGridInfo;    // x=tilePx, y=tilesX, z=tilesY, w=lightCount
    [[vk::offset(336)]] uint4  tiledLightBufferOffsets; // x=lightBase, y=headerBase, z=indexBase
    [[vk::offset(352)]] float4x4 shadowViewProjCascades[3]; // light clip transforms for CSM cascades
    [[vk::offset(544)]] float4 shadowCascadeSplits;         // xyz=split far distances in view-space units
    [[vk::offset(560)]] float4 shadowParams;                // x=depthBiasTexels, y=normalOffsetTexels, z=strength, w=unused
    [[vk::offset(576)]] uint    shadowLightCount;           // number of active local shadow lights
    [[vk::offset(584)]] uint64_t shadowLightDataAddr;       // BDA -> ShadowLightData[]
    [[vk::offset(592)]] float4  frustumPlanes[6];           // normalized planes, xyz=n, w=d
    [[vk::offset(688)]] float4x4 invViewProj;               // inverse view-projection for screen-space reconstruction
    [[vk::offset(752)]] uint64_t resourceTableAddr;         // BDA -> ResourceEntry[kFrameResourceCount]
    [[vk::offset(760)]] uint64_t effectParamBufferAddr;     // BDA of EffectParamBuffer (0 = no effects active)
    [[vk::offset(768)]] float4  shadowCascadeDepthBias;     // xyz = per-cascade constant bias, NDC depth units
    [[vk::offset(784)]] float4  shadowCascadeNormalOffset;  // xyz = per-cascade normal-offset distance, world units
    [[vk::offset(800)]] float4  shadowCascadePenumbraScale; // xyz = penumbra UV width per unit of NDC depth separation
    [[vk::offset(816)]] float4  fogParams;                  // x=density at y=0, y=height falloff, z=sun forward scatter, w=max opacity
};

#endif
