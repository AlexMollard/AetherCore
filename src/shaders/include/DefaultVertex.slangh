#ifndef AETHER_DEFAULT_VERTEX_SLANGH
#define AETHER_DEFAULT_VERTEX_SLANGH

// Requires pc: DrawPushConstants, the vsOutput type from MeshVertex.slangh, and
// includes: FrameConstants.slangh, RenderContracts.slangh, MeshVertex.slangh.

[shader("vertex")]
VSOutput vertexMain(uint vertexId : SV_VertexID, uint startInstance : SV_StartInstanceLocation)
{
    FrameConstantsData* fc = pc.frame.Ptr();
    DrawInstanceData instance = pc.instanceData.Load(startInstance);

    Vertex* verts = (Vertex*)(instance.vertexBufferAddr);
    Vertex input = verts[vertexId];

    float4 worldPos;
    float3 worldNormal;
    float3 worldTangent;

    if (pc.skinPalette.addr != 0uL && instance.skinJointCount > 0u)
    {
        float4x4* joints = pc.skinPalette.Ptr();
        const uint base = instance.skinPaletteOffset;
        const uint jc = instance.skinJointCount;

        uint  j0 = (input.jointIndices.x < jc) ? input.jointIndices.x : 0u;
        uint  j1 = (input.jointIndices.y < jc) ? input.jointIndices.y : 0u;
        uint  j2 = (input.jointIndices.z < jc) ? input.jointIndices.z : 0u;
        uint  j3 = (input.jointIndices.w < jc) ? input.jointIndices.w : 0u;
        float w0 = (input.jointIndices.x < jc) ? input.jointWeights.x : 0.0f;
        float w1 = (input.jointIndices.y < jc) ? input.jointWeights.y : 0.0f;
        float w2 = (input.jointIndices.z < jc) ? input.jointWeights.z : 0.0f;
        float w3 = (input.jointIndices.w < jc) ? input.jointWeights.w : 0.0f;

        const float wsum = w0 + w1 + w2 + w3;
        if (wsum > 1e-6f)
        {
            const float inv = 1.0f / wsum;
            w0 *= inv; w1 *= inv; w2 *= inv; w3 *= inv;
        }
        else
        {
            w0 = 1.0f; w1 = 0.0f; w2 = 0.0f; w3 = 0.0f;
        }

        float4x4 skinMatrix =
            w0 * joints[base + j0] +
            w1 * joints[base + j1] +
            w2 * joints[base + j2] +
            w3 * joints[base + j3];

        float4x4 worldMatrix = mul(instance.model, skinMatrix);
        worldPos = mul(worldMatrix, float4(input.position, 1.0));

        float3x3 world3 = transpose(float3x3(
            worldMatrix[0].xyz,
            worldMatrix[1].xyz,
            worldMatrix[2].xyz
        ));
        worldNormal  = TransformDirectionScaleCorrect(input.normal, world3);
        worldTangent = TransformDirectionScaleCorrect(input.tangent.xyz, world3);
    }
    else
    {
        worldPos     = mul(instance.model, float4(input.position, 1.0));

        float3x3 model3 = transpose(float3x3(
            instance.model[0].xyz,
            instance.model[1].xyz,
            instance.model[2].xyz
        ));
        worldNormal  = TransformDirectionScaleCorrect(input.normal, model3);
        worldTangent = TransformDirectionScaleCorrect(input.tangent.xyz, model3);
    }

    VSOutput o;
    o.svPosition  = mul(fc->viewProj, worldPos);
    o.worldPos    = worldPos.xyz;
    o.worldNormal = worldNormal;
    o.worldTangent = worldTangent;
    o.tangentSign = input.tangent.w;
    o.uv          = input.uv;
    o.uv2         = input.uv2;
    o.vertexColor = input.color;
    o.materialIndex = instance.materialIndex;
#ifdef AETHER_VS_EFFECT_PARAMS
    o.effectParamIndex = instance.effectParamIndex;
#endif
    return o;
}

#endif
