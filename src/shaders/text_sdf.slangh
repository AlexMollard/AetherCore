// SDF glyph alpha utility.
// Include in any shader that samples the font atlas for signed-distance-field text.
//
// Atlas format: R8_UNORM single-channel SDF where:
//   0.0 = far outside, 0.5 = glyph edge, 1.0 = far inside.

#ifndef TEXT_SDF_SLANGH
#define TEXT_SDF_SLANGH

// Returns the antialiased coverage alpha for one SDF glyph sample.
// Uses screen-space derivatives (fwidth) for per-pixel smooth edge transitions
// that stay crisp at any font size.
float SdfGlyphAlpha(Texture2D atlas, SamplerState s, float2 uv)
{
    const float dist = atlas.Sample(s, uv).r;
    const float w    = clamp(fwidth(dist) * 0.7, 0.001, 0.5);
    return smoothstep(0.5 - w, 0.5 + w, dist);
}

#endif // TEXT_SDF_SLANGH
