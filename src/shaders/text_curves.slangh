// Analytic glyph coverage from outline curves (the technique Lengyel published as Slug).
//
// A glyph is a list of quadratic Bezier curves in its own [0,1] box, plus a band table that
// says which curves a ray through a given row or column can possibly meet. For each pixel we
// cast one horizontal and one vertical ray, count signed crossings, and weight each crossing
// by how far it falls across the pixel - which gives exact analytic antialiasing at any
// scale, from one asset, with no atlas and no bake size.
//
// Curve texture layout (RGBA32F, one per font):
//   band entry : (curveTexelStart, curveCount, 0, 0)
//   curve      : (p0.x, p0.y, p1.x, p1.y) then (p2.x, p2.y, 0, 0)
// A curve appears in every band it spans, so the inner loop below is a flat run with no
// indirection past the band entry.

#ifndef TEXT_CURVES_SLANGH
#define TEXT_CURVES_SLANGH

// Texel index -> texture coordinate. The width is read from the resource rather than passed
// in, so nothing has to keep a copy of it in step with the asset.
float4 CurveTexel(Texture2D curves, uint index, uint width)
{
    return curves.Load(int3(int(index % width), int(index / width), 0));
}

// How many crossings a curve contributes to a ray, and which of its two roots they are,
// derived from the SIGN PATTERN of its three control points relative to the ray.
//
// This is the heart of the algorithm and the part I first tried to do without. Solving the
// quadratic and keeping the roots in [0,1] looks equivalent and is not: consecutive curves
// share an endpoint, so a ray through a vertex finds a root on both and counts one crossing
// twice, and a ray through a turning point finds a root that is a touch rather than a
// crossing. Both flip the winding for an entire scanline. Clamping the interval half-open
// fixes the first and not the second.
//
// Classifying by configuration has no such gaps: each of the eight sign patterns says
// exactly how the curve meets the ray, so an endpoint is owned by one curve and an extremum
// contributes nothing, by construction rather than by tolerance. The table is Lengyel's.
uint RootCode(float c0, float c1, float c2)
{
    const uint pattern = (c0 > 0.0 ? 2u : 0u) + (c1 > 0.0 ? 4u : 0u) + (c2 > 0.0 ? 8u : 0u);
    return (0x2E74u >> pattern) & 3u;
}

// The two roots of the quadratic through (c0, c1, c2), in Bezier form a*t^2 - 2b*t + c.
// The near-linear branch matters: a glyph is full of curves whose control point sits almost
// exactly on the chord, and the quadratic formula loses all its precision as `a` vanishes.
void SolveCurve(float c0, float c1, float c2, out float t1, out float t2)
{
    const float a = c0 - 2.0 * c1 + c2;
    const float b = c0 - c1;
    if (abs(a) >= 1e-5)
    {
        const float d = sqrt(max(b * b - a * c0, 0.0));
        t1 = (b - d) / a;
        t2 = (b + d) / a;
    }
    else
    {
        // Degenerate to the straight-line solution rather than dividing by ~0.
        const float t = c0 / (2.0 * b);
        t1 = t;
        t2 = t;
    }
}

// Signed coverage along one axis. `p` is the sample point in glyph space, `bandBase` the
// texel of the first band entry for this axis, `bandCount` how many bands it has, and
// `horizontal` picks which component the ray is cast along.
//
// The winding sum is signed by the direction the contour crosses the ray, so counters (the
// hole in an 'o') subtract exactly as the non-zero fill rule says they should.
float AxisCoverage(Texture2D curves, uint width, float2 p, uint bandBase, uint bandCount,
                   bool horizontal, float pixelExtent)
{
    if (bandCount == 0)
    {
        return 0.0;
    }

    // The ray's position along the banded axis picks the band; clamped because a sample half
    // a pixel outside the quad is legitimate at the very edge of the glyph.
    const float along = horizontal ? p.y : p.x;
    const uint band = uint(clamp(float(bandCount) * along, 0.0, float(bandCount) - 1.0));

    const float4 entry = CurveTexel(curves, bandBase + band, width);
    const uint runStart = uint(entry.x);
    const uint runCount = uint(entry.y);

    const float invExtent = 1.0 / max(pixelExtent, 1e-8);
    float total = 0.0;

    for (uint i = 0; i < runCount; ++i)
    {
        const float4 a = CurveTexel(curves, runStart + i * 2u, width);
        const float4 b = CurveTexel(curves, runStart + i * 2u + 1u, width);
        // Control points relative to the sample point, so the ray is the axis through zero.
        const float2 p0 = a.xy - p;
        const float2 p1 = a.zw - p;
        const float2 p2 = b.xy - p;

        // Along = the component the ray holds constant and solves for; across = the one whose
        // crossing position decides how much of this pixel the curve leaves covered.
        const float a0 = horizontal ? p0.y : p0.x;
        const float a1 = horizontal ? p1.y : p1.x;
        const float a2 = horizontal ? p2.y : p2.x;

        const uint code = RootCode(a0, a1, a2);
        if (code == 0u)
        {
            continue;
        }

        float t1, t2;
        SolveCurve(a0, a1, a2, t1, t2);

        const float x0 = horizontal ? p0.x : p0.y;
        const float x1 = horizontal ? p1.x : p1.y;
        const float x2 = horizontal ? p2.x : p2.y;

        // The sign of each contribution comes from the classification, not from a tangent
        // test - which is the other thing that made the naive version fragile.
        if ((code & 1u) != 0u)
        {
            const float omt = 1.0 - t1;
            const float hit = omt * omt * x0 + 2.0 * omt * t1 * x1 + t1 * t1 * x2;
            total += saturate(hit * invExtent + 0.5);
        }
        if (code > 1u)
        {
            const float omt = 1.0 - t2;
            const float hit = omt * omt * x0 + 2.0 * omt * t2 * x1 + t2 * t2 * x2;
            total -= saturate(hit * invExtent + 0.5);
        }
    }

    return total;
}

// Coverage of one pixel of a glyph. `local` is the fragment's position in the glyph's [0,1]
// box and `pixelSize` the size of a pixel in that same space, both of which the vertex stage
// derives from the quad - so this needs nothing else about the glyph.
float GlyphCoverage(Texture2D curves, uint width, float2 local, float2 pixelSize,
                    uint bandTexel, uint bandCountX, uint bandCountY)
{
    // Two rays rather than one. A single horizontal ray is exact for vertical stems and
    // degenerate for horizontal ones (a crossbar lying along the ray produces no crossing at
    // all); averaging the two axes is what keeps a 'T' and an 'e' equally solid.
    const float horizontal = AxisCoverage(curves, width, local, bandTexel, bandCountX, true, pixelSize.x);
    const float vertical = AxisCoverage(curves, width, local, bandTexel + bandCountX, bandCountY, false, pixelSize.y);
    return saturate((abs(horizontal) + abs(vertical)) * 0.5);
}

#endif // TEXT_CURVES_SLANGH
