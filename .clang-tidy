---
# AetherCore clang-tidy configuration
# Target: C++23 (MSVC) / C++26 (Clang) Vulkan rendering engine
#
# Philosophy:
#   - Catch UB, memory safety, and correctness bugs aggressively
#   - Flag real performance anti-patterns, not micro-style issues
#   - Skip checks that are irrelevant or hostile to engine idioms:
#     raw pointer arithmetic, reinterpret_cast, C arrays, custom allocators,
#     varargs logging, intentional narrowing casts, magic constants
#
# Deliberately excluded categories:
#   cppcoreguidelines-pro-bounds-*        raw array/pointer access is idiomatic
#   cppcoreguidelines-pro-type-reinterpret-cast  engine serialization/GPU work
#   cppcoreguidelines-owning-memory       custom allocators everywhere
#   cppcoreguidelines-no-malloc           allocator wrappers call malloc directly
#   cppcoreguidelines-pro-type-vararg     format/log APIs use varargs
#   cppcoreguidelines-avoid-magic-numbers/readability-magic-numbers  too noisy
#   readability-function-cognitive-complexity    render/physics code is inherently complex
#   readability-identifier-length         i/j/x/y/z are valid
#   modernize-avoid-c-arrays              fixed-size arrays are idiomatic
#   modernize-use-trailing-return-type    style preference
#   modernize-pass-by-value               conflicts with arena/pool allocation patterns
#   hicpp-* cert-* fuchsia-* google-* llvm-* abseil-* android-* objc-*

Checks: >-
  -*,

  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-dangling-handle,
  bugprone-exception-escape,
  bugprone-fold-init-type,
  bugprone-forward-declaration-namespace,
  bugprone-inaccurate-erase,
  bugprone-incorrect-roundings,
  bugprone-integer-overflow,
  bugprone-misplaced-operator-in-strlen-in-alloc,
  bugprone-misplaced-pointer-arithmetic-in-alloc,
  bugprone-misplaced-widening-cast,
  bugprone-move-forwarding-reference,
  bugprone-multiple-statement-macro,
  bugprone-narrowing-conversions,
  bugprone-no-escape,
  bugprone-not-null-terminated-result,
  bugprone-parent-virtual-call,
  bugprone-posix-return,
  bugprone-redundant-branch-condition,
  bugprone-reserved-identifier,
  bugprone-shared-ptr-array-mode,
  bugprone-signed-char-misuse,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-spuriously-wake-up-functions,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-string-literal-with-embedded-nul,
  bugprone-suspicious-enum-usage,
  bugprone-suspicious-include,
  bugprone-suspicious-memory-comparison,
  bugprone-suspicious-missing-comma,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-swapped-arguments,
  bugprone-terminating-continue,
  bugprone-too-small-loop-variable,
  bugprone-undefined-memory-manipulation,
  bugprone-undelegated-constructor,
  bugprone-unhandled-exception-at-new,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-unused-return-value,
  bugprone-use-after-move,
  bugprone-virtual-near-miss,

  clang-analyzer-core.CallAndMessage,
  clang-analyzer-core.DivideZero,
  clang-analyzer-core.NullDereference,
  clang-analyzer-core.StackAddressEscape,
  clang-analyzer-core.UndefinedBinaryOperatorResult,
  clang-analyzer-core.VLASize,
  clang-analyzer-core.uninitialized.ArraySubscript,
  clang-analyzer-core.uninitialized.Assign,
  clang-analyzer-core.uninitialized.Branch,
  clang-analyzer-core.uninitialized.UndefReturn,
  clang-analyzer-cplusplus.InnerPointer,
  clang-analyzer-cplusplus.Move,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  clang-analyzer-cplusplus.PlacementNew,
  clang-analyzer-cplusplus.PureVirtualCall,
  clang-analyzer-cplusplus.STLAlgorithmModeling,
  clang-analyzer-cplusplus.SelfAssignment,
  clang-analyzer-cplusplus.SmartPtrModeling,
  clang-analyzer-deadcode.DeadStores,
  clang-analyzer-nullability.NullPassedToNonnull,
  clang-analyzer-nullability.NullReturnedFromNonnull,
  clang-analyzer-nullability.NullableDereferenced,
  clang-analyzer-security.FloatLoopCounter,
  clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  clang-analyzer-security.insecureAPI.UncheckedReturn,
  clang-analyzer-security.insecureAPI.gets,
  clang-analyzer-security.insecureAPI.mkstemp,
  clang-analyzer-security.insecureAPI.mktemp,
  clang-analyzer-security.insecureAPI.strcpy,
  clang-analyzer-unix.Malloc,
  clang-analyzer-unix.MallocSizeof,
  clang-analyzer-unix.MismatchedDeallocator,
  clang-analyzer-unix.cstring.BadSizeArg,
  clang-analyzer-unix.cstring.NullArg,

  concurrency-mt-unsafe,

  cppcoreguidelines-init-variables,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-const-cast,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,

  # Enable misc-const-correctness incrementally on large codebases;
  # suppress with // NOLINT(misc-const-correctness) on legacy translation units
  misc-const-correctness,
  misc-misplaced-const,
  misc-misleading-bidirectional,
  misc-misleading-identifier,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,
  misc-uniqueptr-reset-release,
  misc-unused-alias-decls,
  misc-unused-parameters,
  misc-unused-using-decls,

  modernize-loop-convert,
  modernize-make-shared,
  modernize-make-unique,
  modernize-redundant-void-arg,
  modernize-use-bool-literals,
  modernize-use-emplace,
  modernize-use-noexcept,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,

  performance-faster-string-find,
  performance-for-range-copy,
  performance-implicit-conversion-in-loop,
  performance-inefficient-algorithm,
  performance-inefficient-string-concatenation,
  performance-inefficient-vector-operation,
  performance-move-const-result,
  performance-move-constructor-init,
  performance-no-automatic-move,
  performance-noexcept-destructor,
  performance-noexcept-move-constructor,
  performance-noexcept-swap,
  performance-trivially-destructible,
  performance-type-promotion-in-math-fn,
  performance-unnecessary-copy-initialization,
  performance-unnecessary-value-param,

  readability-const-return-type,
  readability-container-contains,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-else-after-return,
  readability-implicit-bool-conversion,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-misplaced-array-index,
  readability-non-const-parameter,
  readability-qualified-auto,
  readability-redundant-access-specifiers,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-member-init,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-redundant-string-init,
  readability-simplify-boolean-expr,
  readability-simplify-subscript-expr,
  readability-static-accessed-through-instance,
  readability-string-compare,
  readability-uniqueptr-delete-release,
  readability-use-anyofallof,

# Hard errors: these are UB, crashes, or silent data corruption
WarningsAsErrors: >-
  bugprone-dangling-handle,
  bugprone-undefined-memory-manipulation,
  bugprone-use-after-move,
  clang-analyzer-core.NullDereference,
  clang-analyzer-core.StackAddressEscape,
  clang-analyzer-core.uninitialized.UndefReturn,
  clang-analyzer-cplusplus.NewDelete,
  clang-analyzer-cplusplus.NewDeleteLeaks,
  clang-analyzer-cplusplus.PlacementNew,
  clang-analyzer-cplusplus.PureVirtualCall,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-slicing,
  modernize-use-nullptr,

# Match your engine's source tree roots; exclude third-party/vendor.
# The leading (.*\/)? anchor is critical: unanchored, the regex matches
# `.../_deps/<lib>-src/src/...` because it contains a `/src/` substring.
HeaderFilterRegex: '^(.*/)?(src|include|tools)/.*\.(h|hpp|hxx|hh)$'

# Explicitly suppress diagnostics inside CPM/vendored headers.
# These paths live under the build tree, e.g.
#   D:/AetherCore/build-ninja-clang/_deps/entt-src/src/entt/...
ExcludeHeaderFilterRegex: '.*_deps/.*\.(h|hpp|hxx|hh|inl)$'

SystemHeaders: false

UseColor: true

CheckOptions:
  # Rule of 5: allow classes with only a defaulted dtor to skip the rest
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: 'false'
  # OK to omit move functions when copy is intentionally deleted (move-only types)
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted
    value: 'true'

  # Allow both `override` and `final` without triggering redundancy warning
  - key: modernize-use-override.AllowOverrideAndFinal
    value: 'true'
  - key: modernize-use-override.IgnoreDestructors
    value: 'false'

  # Warn on all auto copies in range-for (not just large types)
  - key: performance-for-range-copy.WarnOnAllAutoCopies
    value: 'true'
  - key: performance-move-const-result.CheckTriviallyCopyableMove
    value: 'true'

  # Const-correctness: transform local values and refs but NOT raw pointer pointees
  # (engine code mutates through raw pointers frequently via out-params and custom allocators)
  - key: misc-const-correctness.TransformValues
    value: 'true'
  - key: misc-const-correctness.TransformReferences
    value: 'true'
  - key: misc-const-correctness.TransformPointersAsValues
    value: 'false'

  # Don't flag unused params with comment-based suppression (e.g. platform stubs)
  - key: misc-unused-parameters.StrictMode
    value: 'false'

  # Pointer conditions are idiomatic (if ptr); integer conditions are implicit bool casts
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: 'false'
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 'true'

  # Narrowing: warn on integer and float narrowing but not same-width int conversions
  # (int32_t <-> uint32_t casts are pervasive in index/handle code)
  - key: cppcoreguidelines-narrowing-conversions.WarnOnIntegerNarrowingConversion
    value: 'true'
  - key: cppcoreguidelines-narrowing-conversions.WarnOnFloatingPointNarrowingConversion
    value: 'true'
  - key: cppcoreguidelines-narrowing-conversions.WarnOnEquivalentBitWidth
    value: 'false'
  - key: cppcoreguidelines-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: 'true'

  # AetherCore assert/expect/log macros
  # - AE_ASSERT / AE_ASSERT_ALWAYS: must be safe to use with side-effecting expressions
  # - AE_TRY / AE_EXPECT_OR_THROW / AE_EXPECT_OR_THROW_VOID / AE_UNEXPECTED: error-handling
  #   flow control; their return-type behavior is intentional
  # - AE_VERBOSE / AE_INFO / AE_WARN / AE_ERROR: varargs format-style logging
  - key: bugprone-assert-side-effect.AssertMacros
    value: 'assert,AE_ASSERT,AE_ASSERT_ALWAYS,AE_CHECK,ASSERT,CHECK'

  # Flag [[nodiscard]]-equivalent STL functions + common engine patterns
  - key: bugprone-unused-return-value.CheckedFunctions
    value: '::std::async;::std::launder;::std::remove;::std::remove_if;::std::unique;::std::unique_ptr::release;::std::basic_string::empty;::std::vector::empty'

  # Only convert loops where the transformation is unambiguously safe
  - key: modernize-loop-convert.MinConfidence
    value: 'reasonable'
  - key: modernize-make-unique.IgnoreMacros
    value: 'true'
  - key: modernize-make-shared.IgnoreMacros
    value: 'true'