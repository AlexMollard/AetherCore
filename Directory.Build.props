<Project>

  <!--
    Repo-wide MSBuild defaults for the managed (C#) projects: the AetherCore SDK,
    AetherCore.Interop (ABI/host boot), and AetherGame (game scripts).

    Everything is guarded to '.csproj' so the CMake-generated C++ .vcxproj under
    build*/ (which also import this file) are left untouched.

    ArtifactsPath routes obj/bin out of the source tree. The CMake build overrides
    it on the `dotnet build` command line to target the CMake binary dir, so this
    default only applies when Visual Studio (or a bare `dotnet build`) evaluates a
    project directly - e.g. on solution load, restore, or right-click Build.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0</TargetFramework>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>

    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
